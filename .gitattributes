# Files read by the byte-bound command-surface guard check out with LF on every host, so a
# Windows clone with core.autocrlf=true sees the same bytes, spans and counts as CI (ADR-0034).
# Later exact-path lines, including the -text evidence bytes, override these defaults.
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.txt text eol=lf
*.template text eol=lf
*.example text eol=lf

*.sh text eol=lf
*.bash text eol=lf
bin/* text eol=lf
install/directories.txt text eol=lf

# Lintel portable Copilot kit
.github/lintel/** text=auto eol=lf
.github/skills/li-*/** text=auto eol=lf
.github/agents/*.agent.md text eol=lf
.github/plugin/hooks.json text eol=lf
.github/hooks/lintel.json text eol=lf
.github/instructions/lintel-session.instructions.md text eol=lf
.github/copilot-instructions.md text eol=lf


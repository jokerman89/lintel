#!/usr/bin/env bash
# component: lintel-lessons-promote
# implements: ADR-0006, ADR-0028
# intent: docs/concepts/memory-v2.md
# constraints: explicit destination and label; never switches, creates or pushes a branch or commits unrelated changes
# last_intent_review: 2026-09-23
#
# li-lessons-promote — promote one ID-managed lesson into the scaffolding baseline
# of an explicitly named Lintel work tree. Argument parsing, the conditional write
# and the optional scoped commit live in bin/li-lessons.py (`promote`).
set -euo pipefail

usage() {
  cat <<'EOF'
li-lessons-promote — promote one lesson into a Lintel work tree's scaffolding baseline

Usage:
  li-lessons-promote --lintel-dir <work tree> --id L-NNN --generalized-file <file> \
                     --source-label <label> [--source <lessons.md>] [--record-source-commit] \
                     [--operator <name>] [--commit --expect-branch <branch>]

Default mode writes only scaffolding/01-foundation/.claude/memory/lessons.md in the
destination (conditional write), prints its diff and suggested commands, and leaves
HEAD, branches and the index unchanged. The destination comes from --lintel-dir or
LINTEL_DIR; there is no implicit default.

Options:
  --source <file>          Source store (default: the project store, lintel_lessons_file)
  --id L-NNN               Lesson to promote; without a terminal it is required
  --generalized-file <f>   Generalized text with exactly one level-two heading; the
                           heading is rewritten to the destination's next ID ($EDITOR
                           is offered interactively instead)
  --source-label <label>   [A-Za-z0-9._-]{1,64}; required without a terminal, so a
                           private repository name is never copied implicitly
  --record-source-commit   Record the source HEAD instead of source_commit=unrecorded
  --operator <name>        Record an operator; otherwise none is recorded
  --lintel-dir <path>      Destination Git work tree (a linked worktree is fine)
  --commit --expect-branch <branch>
                           Commit only the target on <branch> after checking that the
                           branch matches, nothing is staged and the target is clean

Sensitivity is operator-attested; no shared scanner runs on the generalized text.

Exit codes: 0 ok, 2 usage (missing destination, label or single heading), 3 source
missing or outside a repository, 4 destination not a work tree, 5 target missing,
6 invalid or absent lesson ID, 7 already promoted, 8 commit precondition failed,
9 conditional-write conflict, 10 commit failed and bytes restored, 11 committed but
verification failed (the commit is left in place).
EOF
}

for argument in "$@"; do
  case "$argument" in -h|--help) usage; exit 0 ;; esac
done

SOURCE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python="${LINTEL_PYTHON:-}"
if [ -z "$python" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
      python="$candidate"
      break
    fi
  done
fi
if [ -z "$python" ]; then
  echo "li-lessons-promote: Python 3.9+ is required for conditional lesson writes; nothing was written" >&2
  exit 2
fi
exec "$python" "$SOURCE_ROOT/bin/li-lessons.py" promote "$@"

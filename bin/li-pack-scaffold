#!/usr/bin/env bash
# component: extension-pack-scaffold-entry
# implements: ADR-0018, ADR-0030
# intent: .claude/plans/universal-implementation/packages/P10.md
# constraints: source-owned validation/publication; no automatic activation
# last_intent_review: 2026-09-20
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE="${LINTEL_SOURCE_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd -P)}"
case "${1:---help}" in help|-h|--help)
  exec bash "$SOURCE/bin/li-lifecycle" extension-pack --help ;;
esac
exec bash "$SOURCE/bin/li-lifecycle" extension-pack "$@"

#!/usr/bin/env bash
# bin/li-envelope-replay — replay an envelope (defaults to dry-run)
#
# Usage:
#   bin/li-envelope-replay <envelope-file>             # dry-run (default)
#   bin/li-envelope-replay <envelope-file> --apply     # actually re-execute
#   bin/li-envelope-replay --from-audit <envelope-id>  # pull from audit log
#   bin/li-envelope-replay <file> --force              # apply even if replay_safe=false
#
# Defaults: dry-run + no force. Replay is read-only by default per design doc
# §2.3 envelope-replay UX. The world may have moved since the envelope was
# issued, so the operator sees what WOULD run and decides.
#
# Exit codes:
#   0 = replay complete (dry-run or apply)
#   1 = replay refused (envelope invalid, not replay_safe, deprecated)
#   2 = invocation error (file missing, etc.)

set -uo pipefail

REPO_ROOT="${LINTEL_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)}"
LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
AUDIT_DIR="${LINTEL_AUDIT_DIR:-$LINTEL_HOME/audit}"
mkdir -p "$AUDIT_DIR" 2>/dev/null || true

APPLY=0
FORCE=0
INPUT=""
FROM_AUDIT=""
AUDIT_LOG="$AUDIT_DIR/envelope-replay.jsonl"

usage() {
  head -19 "$0" | sed 's/^# \{0,1\}//' | sed '1d'
  exit "${1:-2}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1; shift ;;
    --force) FORCE=1; shift ;;
    --from-audit) FROM_AUDIT="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    -*) echo "ERROR: unknown flag: $1" >&2; usage 2 ;;
    *) INPUT="$1"; shift ;;
  esac
done

# ─── Locate envelope ─────────────────────────────────────────────────────
TMP_ENV=$(mktemp)
trap 'rm -f "$TMP_ENV"' EXIT

if [ -n "$FROM_AUDIT" ]; then
  # Search audit log for an envelope with this id
  found=$(grep -l "\"envelope_id\":\"$FROM_AUDIT\"" "$AUDIT_DIR"/*.jsonl 2>/dev/null | head -1)
  if [ -z "$found" ]; then
    echo "ERROR: envelope_id $FROM_AUDIT not found in $AUDIT_DIR/*.jsonl" >&2
    exit 1
  fi
  grep "\"envelope_id\":\"$FROM_AUDIT\"" "$found" | head -1 > "$TMP_ENV"
elif [ -n "$INPUT" ]; then
  [ -f "$INPUT" ] || { echo "ERROR: $INPUT not found" >&2; exit 2; }
  cp "$INPUT" "$TMP_ENV"
else
  usage 2
fi

# ─── Validate first ──────────────────────────────────────────────────────
VALIDATOR="$REPO_ROOT/bin/li-envelope-validate"
if [ -x "$VALIDATOR" ]; then
  if ! "$VALIDATOR" --quiet "$TMP_ENV"; then
    echo "REFUSED: envelope failed validation. Run li-envelope-validate for details." >&2
    exit 1
  fi
fi

# ─── Read replay metadata ────────────────────────────────────────────────
envelope_id=$(grep -E '^[[:space:]]*envelope_id:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
kind=$(grep -E '^[[:space:]]*kind:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
from=$(grep -E '^[[:space:]]*from:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
to=$(grep -E '^[[:space:]]*to:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
issued_at=$(grep -E '^[[:space:]]*issued_at:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
replay_safe=$(grep -E '^[[:space:]]*replay_safe:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
deprecated_after=$(grep -E '^[[:space:]]*deprecated_after:' "$TMP_ENV" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')

# ─── Dry-run report ──────────────────────────────────────────────────────
echo "================================================================"
echo "LINTEL ENVELOPE REPLAY — $([ "$APPLY" -eq 1 ] && echo 'APPLY' || echo 'DRY-RUN')"
echo "================================================================"
echo "envelope_id:    $envelope_id"
echo "kind:           $kind"
echo "from → to:      $from → $to"
echo "issued_at:      $issued_at"
echo "replay_safe:    ${replay_safe:-unset (default false)}"
echo "deprecated_after: ${deprecated_after:-none}"
echo "================================================================"
echo ""
echo "Envelope body preview (first 40 lines):"
echo "----------------------------------------------------------------"
head -40 "$TMP_ENV"
echo "----------------------------------------------------------------"
echo ""

# ─── Apply guards ────────────────────────────────────────────────────────
if [ "$APPLY" -eq 0 ]; then
  echo "DRY-RUN complete. Re-invoke with --apply to actually replay."
  exit 0
fi

# Refuse apply unless replay_safe OR --force
if [ "$replay_safe" != "true" ] && [ "$FORCE" -eq 0 ]; then
  echo "REFUSED: envelope.tail.replay_safe is not true ($replay_safe). Use --force to override (audited)." >&2
  exit 1
fi

# Refuse apply if past deprecated_after
if [ -n "$deprecated_after" ]; then
  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  if [ "$deprecated_after" \< "$now" ]; then
    echo "REFUSED: envelope deprecated_after $deprecated_after (now=$now)" >&2
    exit 1
  fi
fi

# ─── Apply (audit first, execute is operator-bound per skill type) ───────
ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
operator=$(whoami 2>/dev/null || echo unknown)
forced=$([ "$FORCE" -eq 1 ] && echo true || echo false)

printf '{"ts":"%s","kind":"envelope_replay_applied","envelope_id":"%s","original_kind":"%s","from":"%s","to":"%s","operator":"%s","forced":%s}\n' \
  "$ts" "$envelope_id" "$kind" "$from" "$to" "$operator" "$forced" \
  >> "$AUDIT_LOG"

echo "APPLY recorded to $AUDIT_LOG"
echo ""
echo "Note: this tool records the replay intent. The actual re-invocation of"
echo "the skill/agent ($to) is performed by the operator's Lintel session — "
echo "this binary writes the audit entry that anchors replay history."
exit 0

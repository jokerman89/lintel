#!/usr/bin/env bash
# component: envelope-replay
# implements: ADR-0008, ADR-0027
# intent: .claude/plans/universal-implementation/packages/P04.md
# constraints: validate before preview; apply records intent, never invokes an agent
# last_intent_review: 2026-09-20
set -uo pipefail

SOURCE_ROOT="${LINTEL_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
[ -f "$SOURCE_ROOT/bin/_audit.sh" ] || {
  echo "ERROR: replay audit helper is missing or could not be loaded" >&2
  exit 2
}
source "$SOURCE_ROOT/lib/brief-forge.sh" || exit 2
INPUT=""
FROM_AUDIT=""
APPLY=0
FORCE=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply) APPLY=1; shift ;;
    --force) FORCE=1; shift ;;
    --from-audit)
      [ "$#" -ge 2 ] || { echo "ERROR: --from-audit requires an identifier" >&2; exit 2; }
      FROM_AUDIT="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: li-envelope-replay <file> [--apply] [--force]"
      echo "       li-envelope-replay --from-audit <id> (legacy payload records only)"
      exit 0 ;;
    -*) echo "ERROR: unknown replay flag" >&2; exit 2 ;;
    *) [ -z "$INPUT" ] || { echo "ERROR: supply one envelope" >&2; exit 2; }; INPUT="$1"; shift ;;
  esac
done
[ -n "$INPUT" ] || [ -n "$FROM_AUDIT" ] || { echo "ERROR: envelope input required" >&2; exit 2; }
[ -z "$INPUT" ] || [ -z "$FROM_AUDIT" ] || { echo "ERROR: file and audit selection are mutually exclusive" >&2; exit 2; }
AUDIT_DIR="$(_audit_out_dir envelope-replay)" || exit 1
TMP_ENV=$(mktemp) || exit 2
trap 'rm -f "$TMP_ENV"' EXIT
if [ -n "$FROM_AUDIT" ]; then
  _brief_forge_python lookup "$FROM_AUDIT" "$AUDIT_DIR" "$LINTEL_AUDIT_DIR" > "$TMP_ENV" || exit 1
else
  [ -f "$INPUT" ] || { echo "ERROR: envelope file missing" >&2; exit 2; }
  cp "$INPUT" "$TMP_ENV" || exit 2
fi
VALIDATOR="$SOURCE_ROOT/bin/li-envelope-validate"
[ -f "$VALIDATOR" ] || { echo "REFUSED: required envelope validator is missing" >&2; exit 1; }
bash "$VALIDATOR" --quiet "$TMP_ENV" || { echo "REFUSED: envelope failed validation" >&2; exit 1; }
OPTIONS=()
[ "$APPLY" -eq 0 ] || OPTIONS+=(--apply)
[ "$FORCE" -eq 0 ] || OPTIONS+=(--force)
identity=$(_brief_forge_python replay-check "$TMP_ENV" "${OPTIONS[@]}") || exit 1
if [ "$APPLY" -eq 1 ]; then
  receipt=$(generate_envelope_id) || exit 1
  audit_log envelope-replay envelope_replay_requested \
    "envelope_id=$identity" "audit_receipt=$receipt" "forced=$FORCE" || exit 1
  _brief_forge_python receipt "$AUDIT_DIR" "$receipt" envelope_replay_requested --category envelope-replay || exit 1
fi
_brief_forge_python replay-preview "$TMP_ENV" "${OPTIONS[@]}"

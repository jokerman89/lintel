#!/usr/bin/env bash
# li-doctor — cross-CLI health check
#
# Detects installed AI CLIs, Lintel install state per CLI, version drift,
# scaffolding install, and hook activation.
#
# Usage: li-doctor [--verbose]

set -uo pipefail

LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
VERBOSE=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --verbose|-v) VERBOSE=1; shift ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
RED=$'\033[0;31m'
RESET=$'\033[0m'

ok() { echo "${GREEN}✓${RESET} $*"; }
warn() { echo "${YELLOW}⚠${RESET} $*"; }
fail() { echo "${RED}✗${RESET} $*"; }

echo "Lintel Doctor — health check"
echo "Date: $(date '+%Y-%m-%d %H:%M:%S')"
echo ""

# ── 1. Detect installed CLIs ──
echo "## Installed CLIs"
# Plain variables + a case dispatch, NOT `declare -A`: stock macOS bash 3.2 has no
# associative arrays and dies with a set -u unbound error — and li-doctor is the
# first command a new operator runs.
CLI_CLAUDE="$(command -v claude 2>/dev/null || true)"
CLI_CODEX="$(command -v codex 2>/dev/null || true)"
CLI_CURSOR="$(command -v cursor 2>/dev/null || true)"
CLI_GEMINI="$(command -v gemini 2>/dev/null || true)"
CLI_OPENCODE="$(command -v opencode 2>/dev/null || true)"
CLI_COPILOT="$(command -v copilot 2>/dev/null || true)"
CLI_DROID="$(command -v droid 2>/dev/null || true)"

cli_path() {
  case "$1" in
    claude)   printf '%s' "$CLI_CLAUDE" ;;
    codex)    printf '%s' "$CLI_CODEX" ;;
    cursor)   printf '%s' "$CLI_CURSOR" ;;
    gemini)   printf '%s' "$CLI_GEMINI" ;;
    opencode) printf '%s' "$CLI_OPENCODE" ;;
    copilot)  printf '%s' "$CLI_COPILOT" ;;
    droid)    printf '%s' "$CLI_DROID" ;;
    *)        : ;;
  esac
}

found=0
for cli in claude codex cursor gemini opencode copilot droid; do
  path="$(cli_path "$cli")"
  if [ -n "$path" ]; then
    ok "$cli: $path"
    found=$((found+1))
  else
    [ "$VERBOSE" = "1" ] && echo "  · $cli: not in PATH"
  fi
done
[ "$found" = "0" ] && fail "No AI CLIs detected in PATH"
echo ""

# ── 2. Lintel install per CLI ──
echo "## Lintel install per CLI"

# Claude Code — the installed plugin lives in the plugins cache; same glob as the
# hook-drift + auto-registration checks below. (~/.claude/plugins/li and
# ~/.claude/marketplaces/* were pre-v5 layouts that no longer exist.)
if [ -n "$CLI_CLAUDE" ]; then
  _li_manifest=""
  for _cand in "$HOME/.claude/plugins/cache"/*/li/*/.claude-plugin/plugin.json; do
    [ -f "$_cand" ] && { _li_manifest="$_cand"; break; }
  done
  if [ -n "$_li_manifest" ]; then
    version=$(grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' "$_li_manifest" 2>/dev/null | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    ok "claude code: li@${version:-unknown}"
  else
    warn "claude code: li NOT installed (no plugin under ~/.claude/plugins/cache/*/li/)"
    echo "    Fix: /plugin marketplace add jokerman89/lintel"
    echo "         /plugin install li@jokerman-lintel"
  fi
fi

# Codex
if [ -n "$CLI_CODEX" ]; then
  if codex plugin list 2>/dev/null | grep -qi "li"; then
    ok "codex: li installed"
  else
    warn "codex: li NOT installed (or 'plugin list' command differs)"
    echo "    Fix: /plugins → search li → Install"
  fi
fi

# Gemini
if [ -n "$CLI_GEMINI" ]; then
  if gemini extensions list 2>/dev/null | grep -qi "li"; then
    ok "gemini: li installed"
  else
    warn "gemini: li NOT installed"
    echo "    Fix: gemini extensions install https://github.com/jokerman89/lintel"
  fi
fi

# Copilot CLI
if [ -n "$CLI_COPILOT" ]; then
  if copilot plugin list 2>/dev/null | grep -qi "li"; then
    ok "copilot cli: li installed"
  else
    warn "copilot cli: li NOT installed"
    echo "    Fix: copilot plugin marketplace add jokerman89/lintel"
    echo "         copilot plugin install li@jokerman-lintel"
  fi
fi

# Droid
if [ -n "$CLI_DROID" ]; then
  if droid plugin list 2>/dev/null | grep -qi "li"; then
    ok "droid: li installed"
  else
    warn "droid: li NOT installed"
  fi
fi

echo ""

# ── 3. Scaffolding install ──
echo "## Scaffolding install"
if [ -d "$LINTEL_HOME/scaffolding/01-foundation" ]; then
  ok "scaffolding source at: $LINTEL_HOME/scaffolding/"
  if [ "$VERBOSE" = "1" ]; then
    # GNU stat -c, then BSD stat -f, then 0 — if both stats fail an empty operand
    # would crash $(( )) under set -u; default to 0 and report unknown instead.
    _mtime=$(stat -c %Y "$LINTEL_HOME/scaffolding" 2>/dev/null || stat -f %m "$LINTEL_HOME/scaffolding" 2>/dev/null || echo 0)
    if [ "${_mtime:-0}" -gt 0 ] 2>/dev/null; then
      age_days=$(( ( $(date +%s) - _mtime ) / 86400 ))
      echo "    Last updated: ${age_days} days ago"
    else
      echo "    Last updated: unknown (stat not available)"
    fi
  fi
else
  warn "scaffolding source NOT at $LINTEL_HOME/scaffolding/"
  echo "    Fix: re-run installer, OR git clone jokerman89/lintel ~/.lintel"
fi
echo ""

# ── 3b. Current repo scaffolding adoption ──
# Catches the "factory never ran on this repo" failure: a repo that USES Lintel but
# never had li-scaffold applied to itself (no .claude/, no docs/adr/, thin CLAUDE.md).
echo "## This repo's scaffolding adoption"
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
missing=""
[ -d "$repo_root/.claude" ] || missing="$missing .claude/"
[ -d "$repo_root/.claude/decisions" ] || [ -d "$repo_root/docs/adr" ] || [ -d "$repo_root/docs/decisions" ] || missing="$missing .claude/decisions/"
[ -f "$repo_root/.claude/memory/lessons.md" ] || [ -f "$repo_root/tasks/lessons.md" ] || missing="$missing lessons.md"   # legacy-fallback-ok
# A scaffolded CLAUDE.md restates the protocol; a thin one is just a pointer.
if [ -f "$repo_root/CLAUDE.md" ] && grep -qiE "Workflow Orchestration|Self-Improvement Loop|Auto-mode boundaries" "$repo_root/CLAUDE.md"; then
  claude_scaffolded=1
else
  claude_scaffolded=0; missing="$missing scaffolded-CLAUDE.md"
fi
if [ -z "$missing" ]; then
  ok "repo has its own scaffolding (.claude/, decisions, lessons, scaffolded CLAUDE.md)"
else
  warn "repo is missing its own scaffolding:$missing"
  echo "    This repo uses Lintel but never had the scaffolding applied to itself."
  echo "    Fix: li-scaffold init   (or copy scaffolding/01-foundation/ into the repo root)"
fi

# v5 layout (ADR-0005): one circle of control under .claude/
if [ -f "$repo_root/.claude/lintel-layout.yaml" ]; then
  layout_v=$(grep -E '^layout_version:' "$repo_root/.claude/lintel-layout.yaml" 2>/dev/null | head -1 | awk '{print $2}' | tr -d '\r')
  if [ "${layout_v:-0}" -ge 5 ] 2>/dev/null; then
    ok "v5 .claude/ home layout (layout_version: $layout_v)"
    # auto-memory convergence pointer is machine-local — verify on THIS machine
    if grep -q '"autoMemoryDirectory"' "$repo_root/.claude/settings.local.json" 2>/dev/null; then
      ok "native auto-memory converged (.claude/settings.local.json)"
    else
      warn "autoMemoryDirectory not set for this machine — native auto-memory writes outside the repo"
      echo "    Fix: li-migrate-claude-home   (idempotent — re-stamps the pointer)"
    fi
  else
    warn "layout marker present but layout_version < 5"
  fi
elif [ -f "$repo_root/tasks/lessons.md" ] || [ -d "$repo_root/docs/adr" ]; then   # legacy-fallback-ok (detection target)
  warn "repo uses the legacy pre-v5 layout (tasks/, docs/adr/, .lintel/state/)"   # legacy-fallback-ok (message text)
  echo "    Knowledge and runtime are spread outside .claude/. Grace window ends 2026-09-12."
  echo "    Fix: li-migrate-claude-home --dry-run   (then run without --dry-run)"
fi
echo ""

# ── 4. Hook activation ──
echo "## Hooks"
hook_count=0
if [ -d "$LINTEL_HOME/hooks" ]; then
  hook_count=$(find "$LINTEL_HOME/hooks" -maxdepth 2 -type l 2>/dev/null | wc -l | tr -d ' ')
  if [ "$hook_count" = "0" ]; then
    warn "0 hooks activated (operator opt-in via symlinks expected)"
  else
    ok "$hook_count hook(s) activated"
  fi
else
  warn "no hooks directory at $LINTEL_HOME/hooks/"
fi

# Hook drift: shipped (repo/plugin) vs installed (~/.lintel/hooks/shared)
_shipped_hooks_dir=""
for _cand in "$repo_root/hooks/shared" "$HOME/.claude/plugins/cache"/*/li/*/hooks/shared; do
  [ -d "$_cand" ] && { _shipped_hooks_dir="$_cand"; break; }
done
if [ -n "$_shipped_hooks_dir" ] && [ -d "$LINTEL_HOME/hooks/shared" ]; then
  _shipped=$(find "$_shipped_hooks_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  _installed=$(find "$LINTEL_HOME/hooks/shared" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
  if [ "${_installed:-0}" -lt "${_shipped:-0}" ] 2>/dev/null; then
    warn "hook drift: $_installed installed vs $_shipped shipped — re-run install.sh to refresh ~/.lintel/hooks"
  else
    ok "installed hooks in sync with shipped ($_installed)"
  fi
fi

# Plugin auto-registration (ADR-0008): hooks/hooks.json ships with the plugin
_plugin_hooks=""
for _cand in "$HOME/.claude/plugins/cache"/*/li/*/hooks/hooks.json "$repo_root/hooks/hooks.json"; do
  [ -f "$_cand" ] && { _plugin_hooks="$_cand"; break; }
done
if [ -n "$_plugin_hooks" ]; then
  ok "plugin hook auto-registration present ($_plugin_hooks)"
  case "$_plugin_hooks" in
    "$HOME/.claude/plugins/cache"*) : ;;
    *) warn "auto-registration found only in the repo checkout — the INSTALLED plugin cache predates v5 (update the plugin)" ;;
  esac
else
  warn "no hooks/hooks.json found — session-digest/safety hooks will NOT auto-register (pre-v5 plugin?)"
fi

# Proof of life (ADR-0008): registration is not firing — check for a recent digest record
_digest_seen=""
for _aud in "$repo_root/.claude/runtime/audit/hooks.jsonl" "$LINTEL_HOME/audit/hooks.jsonl"; do
  [ -f "$_aud" ] && grep -q 'session_digest' "$_aud" 2>/dev/null && _digest_seen="$_aud"
done
if [ -n "$_digest_seen" ]; then
  _last_fire=$(grep 'session_digest' "$_digest_seen" | tail -1 | grep -oE '"ts":"[^"]+"' | cut -d'"' -f4)
  ok "session-digest has fired (last: ${_last_fire:-unknown})"
else
  warn "session-digest has NEVER left an audit record — registered is not firing"
  case "$(uname -s 2>/dev/null)" in
    *NT*|*MINGW*|*MSYS*|*CYGWIN*) echo "    Windows note: SessionStart hooks can silently no-fire on Claude Code for Windows (issue I2 / claude-code #59072). If you just started a fresh session and see this, that bug — not Lintel — is the cause." ;;
  esac
  echo "    Verify: start a fresh session (or claude --debug), then re-run li-doctor."
fi

# session-digest (REQUIRED, ADR-0002): auto-registered via plugin hooks.json (v5+),
# or present in ~/.lintel/hooks/ AND merged as SessionStart (legacy path)
if [ -f "$LINTEL_HOME/hooks/shared/session-digest/run.sh" ] || [ -n "$_plugin_hooks" ]; then
  _wired="no"
  [ -n "$_plugin_hooks" ] && grep -q "session-digest" "$_plugin_hooks" 2>/dev/null && _wired="plugin"
  if [ "$_wired" = "no" ]; then
    for _s in "$HOME/.claude/settings.json" "$(git rev-parse --show-toplevel 2>/dev/null)/.claude/settings.json"; do
      [ -f "$_s" ] && grep -q "session-digest" "$_s" 2>/dev/null && _wired="settings"
    done
  fi
  if [ "$_wired" != "no" ]; then
    ok "session-digest wired (via $_wired)"
  else
    warn "session-digest present but NOT wired as SessionStart"
    echo "    The memory snowball will NOT auto-load. Fix: update the plugin (v5+ auto-registers),"
    echo "    or merge hooks/claude-code/session-digest.settings.json into ~/.claude/settings.json"
  fi
else
  warn "session-digest hook missing (memory snowball won't auto-load — see ADR-0002)"
fi
echo ""

# ── Verdict ──
echo "## Verdict"
echo "  CLIs detected: $found"
echo ""
echo "Run 'li-doctor --verbose' for more detail."
echo "Run 'li-update' to update plugin in each CLI."

#!/usr/bin/env bash
# component: lifecycle-diagnostics-entry
# implements: ADR-0028, ADR-0029
# intent: .claude/plans/universal-implementation/packages/P10.md
# constraints: explicit source and target; read-only, no host command execution
# last_intent_review: 2026-09-20
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE="${LINTEL_SOURCE_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd -P)}"
exec bash "$SOURCE/bin/li-lifecycle" doctor "$@"

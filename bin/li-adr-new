#!/usr/bin/env bash
# li-adr-new — bootstrap a new ADR from .claude/decisions/TEMPLATE.md
#
# Usage: li-adr-new "<title>" [--status proposed|accepted]
# component: li-adr-new
# implements: ADR-0005
# intent: .claude/plans/universal-implementation/packages/P01.md
# constraints: render argument values literally; preserve repository templates
# last_intent_review: 2026-09-20

set -euo pipefail

TITLE=""
STATUS="proposed"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)
      [ $# -ge 2 ] || { echo "ERROR: --status requires proposed or accepted" >&2; exit 2; }
      case "$2" in
        proposed|accepted) STATUS="$2" ;;
        *) echo "ERROR: --status requires proposed or accepted" >&2; exit 2 ;;
      esac
      shift 2 ;;
    --help|-h)
      cat <<EOF
li-adr-new — bootstrap a new ADR

Usage:
  li-adr-new "<title>"                 # creates next NNNN-<slug>.md
  li-adr-new "<title>" --status accepted
  li-adr-new --help

What it does:
  1. Finds next ADR number from .claude/decisions/NNNN-*.md
  2. Generates kebab-case slug from title
  3. Reads .claude/decisions/TEMPLATE.md, substitutes title + date + status literally
     (stock ADR placeholders or {{NNNN}}, {{TITLE}}, {{STATUS}}, {{DATE}})
  4. Writes .claude/decisions/<NNNN>-<slug>.md
  5. git checkout -b adr-<NNNN>-<slug>, stage + commit
EOF
      exit 0 ;;
    -*) echo "Unknown arg: $1" >&2; exit 2 ;;
    *)
      if [ -z "$TITLE" ]; then
        TITLE="$1"
        shift
      else
        echo "Unknown arg: $1" >&2; exit 2
      fi
      ;;
  esac
done

[ -n "$TITLE" ] || { echo "Title required. Usage: li-adr-new \"<title>\"" >&2; exit 2; }
# Path contract (ADR-0005): retain the legacy location for un-migrated repos.
# shellcheck source=/dev/null
source "$(dirname "${BASH_SOURCE[0]}")/../lib/paths.sh"
ADR_DIR="$(lintel_decisions_dir)"
[ -d "$ADR_DIR" ] || { echo "$ADR_DIR not found — run li-scaffold init first" >&2; exit 3; }

TEMPLATE="$ADR_DIR/TEMPLATE.md"
[ -f "$TEMPLATE" ] || { echo "TEMPLATE missing: $TEMPLATE" >&2; exit 4; }

# Find next number
last_num=0
for existing in "$ADR_DIR"/[0-9]*-*.md; do
  [ -f "$existing" ] || continue
  number="${existing##*/}"; number="${number%%-*}"
  [[ "$number" =~ ^[0-9]+$ ]] || continue
  number=$((10#$number))
  if [ "$number" -gt "$last_num" ]; then last_num="$number"; fi
done
next_num=$((last_num + 1))
printf -v nnnn "%04d" "$next_num"

# Slug
slug=$(printf '%s' "$TITLE" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-40)
[ -n "$slug" ] || { echo "ERROR: title must contain a letter or digit" >&2; exit 2; }

FILE="$ADR_DIR/${nnnn}-${slug}.md"
[ -f "$FILE" ] && { echo "ADR already exists: $FILE" >&2; exit 5; }

# Render both the shipped skeleton and token-based custom templates without eval/sed code.
today="$(date +%Y-%m-%d)"
case "$STATUS" in accepted) display_status="Accepted" ;; *) display_status="Proposed" ;; esac
content="$(cat "$TEMPLATE")"
content="${content//"# ADR-NNNN: <Short decision title>"/"# ADR-$nnnn: {{TITLE}}"}"
content="${content//"- **Status:** Proposed"/"- **Status:** $display_status"}"
content="${content//"YYYY-MM-DD"/"$today"}"
content="${content//\{\{NNNN\}\}/"$nnnn"}"
content="${content//\{\{STATUS\}\}/"$STATUS"}"
content="${content//\{\{DATE\}\}/"$today"}"
content="${content//\{\{TITLE\}\}/"$TITLE"}"
printf '%s\n' "$content" > "$FILE"

echo "✓ Created: $FILE"

# Branch + stage + commit
if git rev-parse --git-dir > /dev/null 2>&1; then
  branch="adr-${nnnn}-${slug}"
  git checkout -q -b "$branch" 2>/dev/null || git checkout -q "$branch"
  git add "$FILE"
  git commit -q -m "adr: $nnnn $TITLE"
  echo "✓ Committed on branch: $branch"
  echo ""
  echo "Next:"
  echo "  1. Edit $FILE — fill in Context, Decision, Consequences, Alternatives"
  echo "  2. Re-commit as needed: git commit -am 'adr: $nnnn — details'"
  echo "  3. Push + PR: git push -u origin $branch"
else
  echo "(not in a git repo — skipped commit)"
fi

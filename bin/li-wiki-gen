<h2>System map</h2>

<table>
  <thead><tr><th>Layer</th><th>What lives here</th></tr></thead>
  <tbody>
    <tr><td>foundation</td><td>cycle, sense, scope, define, discover, plan, build, review, ship, capture</td></tr>
    <tr><td>workflow</td><td>orientator, brief-forge, pack-*, v4-migrate</td></tr>
    <tr><td>schemas</td><td>pack-schema.yaml, envelope-schema.yaml</td></tr>
    <tr><td>tools</td><td>li-envelope-validate, li-envelope-replay, li-wiki-gen, li-compat-audit</td></tr>
    <tr><td>packs</td><td>_default (neutral base) + optional external packs via inheritance</td></tr>
  </tbody>
</table>

<h2>Architecture</h2>

<p>Lintel is pack-driven and company-neutral. Three contracts hold it together:</p>

<table>
  <thead><tr><th>Contract</th><th>What it does</th><th>Where</th></tr></thead>
  <tbody>
    <tr><td>Pack manifest</td><td>Declarative identity per team or domain</td><td>lib/pack-schema.yaml</td></tr>
    <tr><td>Envelope</td><td>Optional structure for hand-offs (HEAD + BODY + TAIL)</td><td>lib/envelope-schema.yaml</td></tr>
    <tr><td>Meta-infra discipline</td><td>4 mandatory gates (M1-M4) on scaffolding changes</td><td>skills/cycle, bin/li-compat-audit</td></tr>
  </tbody>
</table>

<div class="meta">
Generated: ${ts} by <a href="https://github.com/jokerman89/lintel/blob/main/bin/li-wiki-gen">bin/li-wiki-gen</a>.
Hand edits will be overwritten on next regen. Source: skills/, agents/, packs/, lib/.
</div>

</body>
</html>
EOF
  echo "wrote $out"
}

# ─── Main ─────────────────────────────────────────────────────────────────
# Regenerate README's capability section from the single source, preserving prose.
gen_cli_table() {
  source "$REPO_ROOT/lib/cli-tiers.sh"
  local readme="$OUTPUT_BASE/README.md"
  [ -f "$readme" ] || readme="$REPO_ROOT/README.md"
  cli_tiers_markdown_table > "$TMP_DIR/cli-table.md"
  awk -v table="$TMP_DIR/cli-table.md" '
    /CLI-TIERS:START/ { print; while ((getline line < table) > 0) print line; close(table); skip=1; starts++; next }
    /CLI-TIERS:END/ { skip=0; ends++ }
    !skip { print }
    END { if (starts != 1 || ends != 1) exit 2 }
  ' "$readme" > "$TMP_DIR/readme-generated.md" || return 2
  cp "$TMP_DIR/readme-generated.md" "$OUTPUT_BASE/README.md"
}

if [ "$CHECK" -eq 1 ]; then
  BASELINE="$OUTPUT_BASE"
  OUTPUT_BASE="$TMP_DIR/generated"
  WIKI_DIR="$OUTPUT_BASE/docs/wiki"
  SHOWCASE_FILE="$OUTPUT_BASE/docs/showcase/lintel-the-harness.html"
  mkdir -p "$WIKI_DIR" "$(dirname "$SHOWCASE_FILE")"
  [ ! -f "$BASELINE/README.md" ] || cp "$BASELINE/README.md" "$OUTPUT_BASE/README.md"
  gen_wiki_readme >/dev/null
  gen_wiki_skills >/dev/null
  gen_wiki_agents >/dev/null
  gen_wiki_packs >/dev/null
  gen_wiki_schemas >/dev/null
  gen_showcase >/dev/null
  gen_cli_table || exit 2
  CHANGED=0
  for relative in README.md docs/wiki/README.md docs/wiki/skills.md docs/wiki/agents.md docs/wiki/packs.md docs/wiki/schemas.md docs/showcase/lintel-the-harness.html; do
    if [ ! -f "$BASELINE/$relative" ] || ! diff -q <(tr -d '\r' < "$BASELINE/$relative") <(tr -d '\r' < "$OUTPUT_BASE/$relative") >/dev/null; then
      echo "STALE: $relative (run bash bin/li-wiki-gen)"
      CHANGED=1
    fi
  done
  [ "$CHANGED" -eq 0 ] || exit 1
  echo 'li-wiki-gen --check: clean'
  exit 0
fi
if [ "$WIKI_ONLY" -eq 0 ] && [ "$SHOWCASE_ONLY" -eq 0 ]; then
  WIKI_ONLY=1
  SHOWCASE_ONLY=1
fi

if [ "$WIKI_ONLY" -eq 1 ]; then
  gen_wiki_readme
  gen_wiki_skills
  gen_wiki_agents
  gen_wiki_packs
  gen_wiki_schemas
fi

if [ "$SHOWCASE_ONLY" -eq 1 ]; then
  gen_showcase
fi

echo ""
gen_cli_table || exit 2
echo "li-wiki-gen: complete"

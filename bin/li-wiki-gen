#!/usr/bin/env bash
# bin/li-wiki-gen — regenerates docs/wiki/ + docs/showcase/lintel-the-harness.html
# from skills/, agents/, packs/, lib/ sources.
#
# Closes v3.7 gap "wiki vs showcase drift" — both outputs from the same sources.
#
# Usage:
#   bin/li-wiki-gen                       # regenerate both outputs
#   bin/li-wiki-gen --check               # exit 1 if regen would change anything
#   bin/li-wiki-gen --wiki-only           # only docs/wiki/
#   bin/li-wiki-gen --showcase-only       # only docs/showcase/
#   bin/li-wiki-gen --output <dir>        # custom output base
#
# Exit codes:
#   0 = generation complete (or --check found no diffs)
#   1 = --check found diffs (used by CI; warn-only)
#   2 = invocation error

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUTPUT_BASE="$REPO_ROOT"
CHECK=0
WIKI_ONLY=0
SHOWCASE_ONLY=0

usage() {
  head -16 "$0" | sed 's/^# \{0,1\}//' | sed '1d'
  exit "${1:-2}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --wiki-only) WIKI_ONLY=1; shift ;;
    --showcase-only) SHOWCASE_ONLY=1; shift ;;
    --output) OUTPUT_BASE="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    *) echo "ERROR: unknown arg: $1" >&2; usage 2 ;;
  esac
done

# Source wiki-gen helpers
if [ -f "$REPO_ROOT/lib/wiki-gen.sh" ]; then
  # shellcheck disable=SC1091
  source "$REPO_ROOT/lib/wiki-gen.sh"
fi

WIKI_DIR="$OUTPUT_BASE/docs/wiki"
SHOWCASE_FILE="$OUTPUT_BASE/docs/showcase/lintel-the-harness.html"
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

mkdir -p "$WIKI_DIR" "$(dirname "$SHOWCASE_FILE")" 2>/dev/null

# ─── Helpers ──────────────────────────────────────────────────────────────
# Extract frontmatter field from a markdown file
get_fm_field() {
  local file="$1" field="$2"
  awk -v field="$field" '
    /^---$/ { if (++fm == 2) exit; next }
    fm == 1 && $0 ~ "^"field":" {
      sub("^"field":[[:space:]]*", "")
      sub("[[:space:]]*#.*$", "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      print
      exit
    }
  ' "$file"
}

# Extract multiple frontmatter fields in a single awk pass.
# Outputs lines of "field=value" for each requested field.
get_fm_fields_batch() {
  local file="$1"
  shift
  local fields="$*"
  awk -v fields="$fields" '
    BEGIN {
      n = split(fields, fnames, " ")
      for (i = 1; i <= n; i++) want[fnames[i]] = 1
    }
    /^---$/ { if (++fm == 2) exit; next }
    fm == 1 {
      for (f in want) {
        if ($0 ~ "^"f":") {
          v = $0
          sub("^"f":[[:space:]]*", "", v)
          sub("[[:space:]]*#.*$", "", v)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
          print f "=" v
          delete want[f]
        }
      }
    }
  ' "$file"
}

# ─── Generate wiki: skills index ──────────────────────────────────────────
gen_wiki_skills() {
  local out="$WIKI_DIR/skills.md"
  {
    echo "# Lintel skills — generated"
    echo ""
    echo "Generated by \`bin/li-wiki-gen\`. Do not hand-edit; changes will be overwritten."
    echo ""
    echo "| Name | Layer | Workflow root | Voice | CLI |"
    echo "|---|---|---|---|---|"

    while IFS= read -r f; do
      local name="" layer="" wr="" voice="" cli=""
      # Single awk pass for all fields
      while IFS='=' read -r k v; do
        case "$k" in
          name) name="$v" ;;
          layer) layer="$v" ;;
          workflow_root) [ "$v" = "true" ] && wr="yes" ;;
          voice) voice="$v" ;;
          cli_support) cli="$v" ;;
        esac
      done < <(get_fm_fields_batch "$f" name layer workflow_root voice cli_support)
      [ -z "$name" ] && continue
      printf '| %s | %s | %s | %s | %s |\n' "$name" "$layer" "$wr" "$voice" "$cli"
    done < <(find "$REPO_ROOT/skills" -name "SKILL.md" -type f 2>/dev/null | sort)
  } > "$out"
  echo "wrote $out"
}

# ─── Generate wiki: agents index ──────────────────────────────────────────
gen_wiki_agents() {
  local out="$WIKI_DIR/agents.md"
  {
    echo "# Lintel agents — generated"
    echo ""
    echo "Generated by \`bin/li-wiki-gen\`. Do not hand-edit."
    echo ""
    echo "| Name | Category | Voice | CLI |"
    echo "|---|---|---|---|"

    while IFS= read -r f; do
      local name="" category="" voice="" cli=""
      # Single awk pass for all fields
      while IFS='=' read -r k v; do
        case "$k" in
          name) name="$v" ;;
          category) category="$v" ;;
          voice) voice="$v" ;;
          cli_support) cli="$v" ;;
        esac
      done < <(get_fm_fields_batch "$f" name category voice cli_support)
      [ -z "$name" ] && continue
      printf '| %s | %s | %s | %s |\n' "$name" "$category" "$voice" "$cli"
    done < <(find "$REPO_ROOT/agents" -name "*.md" -type f 2>/dev/null | grep -v README | sort)
  } > "$out"
  echo "wrote $out"
}

# ─── Generate wiki: packs index ───────────────────────────────────────────
gen_wiki_packs() {
  local out="$WIKI_DIR/packs.md"
  {
    echo "# Lintel packs — generated"
    echo ""
    echo "Generated by \`bin/li-wiki-gen\`. Do not hand-edit."
    echo ""
    echo "| Name | Extends | Voice | Compliance | Requires |"
    echo "|---|---|---|---|---|"

    # Strip whitespace, comments, quotes from a scalar value
    _pack_scalar() {
      printf '%s' "$1" | sed 's/#.*$//' | tr -d '"' | tr -d "'" | tr -d '[:space:]'
    }

    while IFS= read -r f; do
      local name extends voice_tier comp_mode requires
      name=$(_pack_scalar "$(grep -E "^name:" "$f" | head -1 | awk -F': *' '{print $2}')")
      extends=$(_pack_scalar "$(grep -E "^extends:" "$f" | head -1 | awk -F': *' '{print $2}')")
      [ -z "$extends" ] && extends="(none)"
      voice_tier=$(_pack_scalar "$(grep -A2 "^voice:" "$f" | grep "default_tier:" | head -1 | awk -F': *' '{print $2}')")
      comp_mode=$(_pack_scalar "$(grep -A2 "^compliance:" "$f" | grep "mode:" | head -1 | awk -F': *' '{print $2}')")
      requires=$(_pack_scalar "$(grep -E "^requires_lintel:" "$f" | head -1 | awk -F': *' '{print $2}')")
      [ -z "$name" ] && continue
      printf '| %s | %s | %s | %s | %s |\n' "$name" "$extends" "$voice_tier" "$comp_mode" "$requires"
    done < <(find "$REPO_ROOT/packs" -name "pack.yaml" -type f 2>/dev/null | sort)
  } > "$out"
  echo "wrote $out"
}

# ─── Generate wiki: schemas index ─────────────────────────────────────────
gen_wiki_schemas() {
  local out="$WIKI_DIR/schemas.md"
  {
    echo "# Lintel schemas — generated"
    echo ""
    echo "Generated by \`bin/li-wiki-gen\`. Do not hand-edit."
    echo ""
    echo "## Pack manifest schema"
    echo "Source: \`lib/pack-schema.yaml\`"
    echo ""
    if [ -f "$REPO_ROOT/lib/pack-schema.yaml" ]; then
      local sv
      sv=$(grep -E "^schema_version:" "$REPO_ROOT/lib/pack-schema.yaml" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
      echo "schema_version: $sv"
      echo ""
      echo "Required top-level fields: name, version, voice, compliance, navigation, requires_lintel"
      echo ""
      echo "See [pack-defaults.md](../concepts/pack-defaults.md) and [pack-inheritance.md](../concepts/pack-inheritance.md)."
    fi
    echo ""
    echo "## Envelope schema"
    echo "Source: \`lib/envelope-schema.yaml\`"
    echo ""
    if [ -f "$REPO_ROOT/lib/envelope-schema.yaml" ]; then
      local sv
      sv=$(grep -E "^schema_version:" "$REPO_ROOT/lib/envelope-schema.yaml" | head -1 | awk -F': *' '{print $2}' | tr -d '"' | tr -d "'" | tr -d '[:space:]')
      echo "schema_version: $sv"
      echo ""
      echo "Structure: HEAD (6 required) + BODY (content_type discriminator) + TAIL (4 required)"
      echo ""
      echo "See [envelope.md](../concepts/envelope.md)."
    fi
  } > "$out"
  echo "wrote $out"
}

# ─── Generate wiki: README index ──────────────────────────────────────────
gen_wiki_readme() {
  local out="$WIKI_DIR/README.md"
  local ts
  ts="${WGEN_TS:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")}"
  cat > "$out" <<EOF
# Lintel wiki — generated reference

Generated: $ts by \`bin/li-wiki-gen\`.

## Indexes

- [skills.md](skills.md) — every skill in skills/
- [agents.md](agents.md) — every agent in agents/
- [packs.md](packs.md) — every pack in packs/
- [schemas.md](schemas.md) — pack-schema + envelope-schema

## Concept docs

See [docs/concepts/](../concepts/) for canonical conceptual references:

$(for f in "$REPO_ROOT"/docs/concepts/*.md; do [ -f "$f" ] && printf -- '- [%s](../concepts/%s)
' "$(basename "$f" .md)" "$(basename "$f")"; done)

## Hand-editing

This wiki is regenerated from source. **Hand edits will be overwritten.** To change content, edit the source (frontmatter, pack.yaml, schema files) and re-run \`bin/li-wiki-gen\`.

CI runs \`bin/li-wiki-gen --check\` and warns on a diff.
EOF
  echo "wrote $out"
}

# ─── Generate showcase HTML ───────────────────────────────────────────────
gen_showcase() {
  local out="$SHOWCASE_FILE"
  local ts
  ts="${WGEN_TS:-$(date -u +"%Y-%m-%dT%H:%M:%SZ")}"

  local skill_count agent_count pack_count
  skill_count=$(find "$REPO_ROOT/skills" -name "SKILL.md" -type f 2>/dev/null | wc -l | tr -d ' ')
  agent_count=$(find "$REPO_ROOT/agents" -name "*.md" -type f 2>/dev/null | grep -cv README || echo 0)
  pack_count=$(find "$REPO_ROOT/packs" -name "pack.yaml" -type f 2>/dev/null | wc -l | tr -d ' ')

  cat > "$out" <<EOF
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Lintel — the harness</title>
<style>
  :root { --bg: #0a0a0a; --fg: #e8e8e8; --accent: #00ff9c; --muted: #6a6a6a; }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--fg); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; margin: 0; padding: 4rem 6rem; line-height: 1.6; }
  h1 { font-size: 3rem; letter-spacing: -0.04em; color: var(--accent); margin: 0 0 0.5rem; }
  h2 { font-size: 1.5rem; color: var(--accent); margin-top: 3rem; border-bottom: 1px solid var(--accent); padding-bottom: 0.25rem; }
  .tagline { color: var(--muted); font-size: 1.1rem; margin-bottom: 3rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin: 2rem 0; }
  .stat { background: rgba(0, 255, 156, 0.08); padding: 1.5rem; border-left: 3px solid var(--accent); }
  .stat-n { font-size: 2.5rem; color: var(--accent); font-weight: bold; }
  .stat-label { color: var(--muted); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.1em; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { text-align: left; padding: 0.5rem 1rem; border-bottom: 1px solid var(--muted); }
  th { color: var(--accent); }
  .meta { color: var(--muted); font-size: 0.85rem; margin-top: 4rem; }
  .meta a { color: var(--accent); }
</style>
</head>
<body>

<h1>Lintel</h1>
<div class="tagline">the harness — scaffolding that makes AI-augmented engineering compound</div>

<div class="grid">
  <div class="stat">
    <div class="stat-n">${skill_count}</div>
    <div class="stat-label">Skills</div>
  </div>
  <div class="stat">
    <div class="stat-n">${agent_count}</div>
    <div class="stat-label">Agents</div>
  </div>
  <div class="stat">
    <div class="stat-n">${pack_count}</div>
    <div class="stat-label">Packs</div>
  </div>
</div>

<h2>System map</h2>

<table>
  <thead><tr><th>Layer</th><th>What lives here</th></tr></thead>
  <tbody>
    <tr><td>foundation</td><td>cycle, plan, sense, define, discover, build, review, ship, capture</td></tr>
    <tr><td>workflow</td><td>orientator, brief-forge, pack-*, v4-migrate</td></tr>
    <tr><td>schemas</td><td>pack-schema.yaml, envelope-schema.yaml</td></tr>
    <tr><td>tools</td><td>li-envelope-validate, li-envelope-replay, li-wiki-gen, li-compat-audit</td></tr>
    <tr><td>packs</td><td>_default (neutral base) + optional external packs via inheritance</td></tr>
  </tbody>
</table>

<h2>Architecture</h2>

<p>Lintel is pack-driven and company-neutral. Three contracts hold it together:</p>

<table>
  <thead><tr><th>Contract</th><th>What it does</th><th>Where</th></tr></thead>
  <tbody>
    <tr><td>Pack manifest</td><td>Declarative identity per team or domain</td><td>lib/pack-schema.yaml</td></tr>
    <tr><td>Envelope</td><td>Universal shape for every hand-off (HEAD + BODY + TAIL)</td><td>lib/envelope-schema.yaml</td></tr>
    <tr><td>Meta-infra discipline</td><td>4 mandatory gates (M1-M4) on scaffolding changes</td><td>skills/cycle, bin/li-compat-audit</td></tr>
  </tbody>
</table>

<div class="meta">
Generated: ${ts} by <a href="https://github.com/jokerman89/lintel/blob/main/bin/li-wiki-gen">bin/li-wiki-gen</a>.
Hand edits will be overwritten on next regen. Source: skills/, agents/, packs/, lib/.
</div>

</body>
</html>
EOF
  echo "wrote $out"
}

# ─── Main ─────────────────────────────────────────────────────────────────
if [ "$CHECK" -eq 1 ]; then
  # Compare against current; exit 1 if anything would change.
  # Snapshot current state
  CUR_STATE=$(mktemp)
  trap 'rm -f "$CUR_STATE"; rm -rf "$TMP_DIR"' EXIT
  {
    find "$WIKI_DIR" -type f -exec md5sum {} \; 2>/dev/null
    [ -f "$SHOWCASE_FILE" ] && md5sum "$SHOWCASE_FILE"
  } | sort > "$CUR_STATE"

  # Regen to a tmp output base
  OUTPUT_BASE="$TMP_DIR"
  WIKI_DIR="$TMP_DIR/docs/wiki"
  SHOWCASE_FILE="$TMP_DIR/docs/showcase/lintel-the-harness.html"
  mkdir -p "$WIKI_DIR" "$(dirname "$SHOWCASE_FILE")"

  gen_wiki_readme >/dev/null
  gen_wiki_skills >/dev/null
  gen_wiki_agents >/dev/null
  gen_wiki_packs >/dev/null
  gen_wiki_schemas >/dev/null
  gen_showcase >/dev/null

  NEW_STATE=$(mktemp)
  {
    find "$WIKI_DIR" -type f -exec md5sum {} \; 2>/dev/null | sed "s|$TMP_DIR/||"
    [ -f "$SHOWCASE_FILE" ] && md5sum "$SHOWCASE_FILE" | sed "s|$TMP_DIR/||"
  } | sort > "$NEW_STATE"

  # Strip path prefix from CUR_STATE for comparison
  CUR_STRIP=$(mktemp)
  sed "s|$OUTPUT_BASE/||g" "$CUR_STATE" | sort > "$CUR_STRIP"

  if diff -q "$CUR_STRIP" "$NEW_STATE" >/dev/null 2>&1; then
    echo "li-wiki-gen --check: clean (no regeneration needed)"
    rm -f "$CUR_STATE" "$NEW_STATE" "$CUR_STRIP"
    exit 0
  else
    echo "li-wiki-gen --check: DIFF (warn-only)"
    diff "$CUR_STRIP" "$NEW_STATE" || true
    rm -f "$CUR_STATE" "$NEW_STATE" "$CUR_STRIP"
    exit 1
  fi
fi

if [ "$WIKI_ONLY" -eq 0 ] && [ "$SHOWCASE_ONLY" -eq 0 ]; then
  WIKI_ONLY=1
  SHOWCASE_ONLY=1
fi

if [ "$WIKI_ONLY" -eq 1 ]; then
  gen_wiki_readme
  gen_wiki_skills
  gen_wiki_agents
  gen_wiki_packs
  gen_wiki_schemas
fi

if [ "$SHOWCASE_ONLY" -eq 1 ]; then
  gen_showcase
fi

echo ""
echo "li-wiki-gen: complete"

#!/usr/bin/env bash
# Install or verify the portable, repository-scoped GitHub Copilot kit.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$SCRIPT_DIR/li-copilot.py" "$@"
elif command -v python >/dev/null 2>&1; then
  exec python "$SCRIPT_DIR/li-copilot.py" "$@"
else
  echo "ERROR: li-copilot requires Python 3.9+ (python3 or python on PATH)." >&2
  exit 2
fi

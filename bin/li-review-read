#!/usr/bin/env bash
# bin/li-review-read — native review-log reader for the release gate
#
# The release gate's "Review readiness check" calls this. It reads Lintel's own
# audit log at .claude/runtime/audit/reviews.jsonl (with a global ~/.lintel/audit/
# fallback for un-migrated repos) and emits the verdict shape the release gate
# expects: whether an Eng Review is CLEAR within 7 days for the current commit.
# First-party by design — no external binary on the read path.
#
# Grace-window cleanup (until 2026-09-12): any legacy review records written
# before this remediation (${GSTACK_HOME:-$HOME/.gstack}/projects/<slug>/<branch>-reviews.jsonl)
# are imported ONCE into the native reviews.jsonl, idempotently — a marker prevents
# re-import — after which this reader reads only the native file. Historical entries
# still count toward the gate; the legacy path stops being on the read path.
#
# Usage:
#   bin/li-review-read                  # human + machine verdict to stdout
#   bin/li-review-read --skill <name>   # gate on a specific skill (default: plan-eng-review)
#   bin/li-review-read --days <N>       # freshness window (default: 7)
#   bin/li-review-read --json           # emit records as JSONL only (no verdict block)
#
# Output (default): raw review records, then a ---VERDICT--- block the release gate reads:
#   VERDICT: Eng Review CLEAR within 7 days   (or)   VERDICT: NO fresh Eng Review
#   plus the matched record's status/commit/age and current HEAD.
#
# Exit codes:
#   0 = a fresh CLEAR record for the current commit was found (gate may proceed)
#   3 = no fresh/CLEAR record for current commit (gate should surface + ask)
#   2 = invocation error

set -uo pipefail

REPO_ROOT="${LINTEL_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)}"

LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
LINTEL_AUDIT_DIR="${LINTEL_AUDIT_DIR:-$LINTEL_HOME/audit}"

# Source the unified audit helper so the legacy one-time import below routes
# through audit_log() (the single sanctioned JSONL writer) and so the reader and
# writer agree on the reviews-log path via _audit_out_dir.
AUDIT_LIB="$REPO_ROOT/bin/_audit.sh"
# shellcheck source=/dev/null
[ -f "$AUDIT_LIB" ] && source "$AUDIT_LIB"

# Canonical reviews log. _audit_out_dir routes to <repo>/.claude/runtime/audit/
# on the v5 layout, else ~/.lintel/audit/ (global fallback for un-migrated repos).
if command -v _audit_out_dir >/dev/null 2>&1; then
  REVIEWS_LOG="$(_audit_out_dir reviews)/reviews.jsonl"
else
  WORK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
  REVIEWS_LOG="$WORK_ROOT/.claude/runtime/audit/reviews.jsonl"
  [ -f "$REVIEWS_LOG" ] || REVIEWS_LOG="$LINTEL_AUDIT_DIR/reviews.jsonl" # legacy-fallback-ok
fi

GATE_SKILL="plan-eng-review"
DAYS=7
JSON_ONLY=0

usage() {
  head -34 "$0" | sed 's/^# \{0,1\}//' | sed '1d'
  exit "${1:-2}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --skill) GATE_SKILL="${2:-}"; shift 2 ;;
    --days)  DAYS="${2:-7}"; shift 2 ;;
    --json)  JSON_ONLY=1; shift ;;
    -h|--help) usage 0 ;;
    -*) echo "li-review-read: unknown flag: $1" >&2; usage 2 ;;
    *) echo "li-review-read: unexpected arg: $1" >&2; usage 2 ;;
  esac
done

HEAD_SHORT="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

# ── Derive the legacy review path (slug + branch) for the one-time import ──
# Mirrors the historical slug derivation: sanitized to [a-zA-Z0-9._-]. Used only
# by the grace-window import below, not on the steady-state read path.
_legacy_review_file() {
  local slug branch remote raw
  remote="$(git remote get-url origin 2>/dev/null || echo "")"
  if [ -n "$remote" ]; then
    raw="$(printf '%s' "$remote" | sed 's|.*[:/]\([^/]*/[^/]*\)\.git$|\1|;s|.*[:/]\([^/]*/[^/]*\)$|\1|' | tr '/' '-')"
    slug="$(printf '%s' "$raw" | tr -cd 'a-zA-Z0-9._-')"
  fi
  slug="${slug:-$(basename "$PWD" | tr -cd 'a-zA-Z0-9._-')}"
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null | tr -cd 'a-zA-Z0-9._-')"
  branch="${branch:-unknown}"
  printf '%s/projects/%s/%s-reviews.jsonl' "${GSTACK_HOME:-$HOME/.gstack}" "$slug" "$branch"
}
LEGACY_LOG="$(_legacy_review_file)"

# ── One-time grace-window import of legacy records into the native log ──
# If a legacy review file exists and has not been imported yet, fold each of its
# records into the native log exactly once — via audit_log() (the single sanctioned
# JSONL writer), NOT a raw append, so the audit-writes-via-helper contract holds.
# A marker (a plain state file, no .jsonl in its name) guards re-import. After this
# the legacy path is no longer read; only the native file is. Removable after 2026-09-12.
IMPORTED=0
REVIEWS_DIR="$(dirname "$REVIEWS_LOG")"
MARKER="$REVIEWS_DIR/reviews-legacy-import.done"
if [ -f "$LEGACY_LOG" ] && command -v audit_log >/dev/null 2>&1; then
  # Marker records which legacy file was already folded in (path keys the import).
  if ! { [ -f "$MARKER" ] && grep -Fxq "$LEGACY_LOG" "$MARKER" 2>/dev/null; }; then
    mkdir -p "$REVIEWS_DIR" 2>/dev/null || true
    while IFS= read -r legacy_line; do
      [ -z "$legacy_line" ] && continue
      # Mirror li-review-log's record shape: preserve the legacy payload verbatim
      # under "raw" (the verdict awk matches the escaped "skill" inside it) plus the
      # parsed status/commit/review_ts when present.
      l_skill="$(printf '%s' "$legacy_line" | sed -n 's/.*"skill"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
      l_status="$(printf '%s' "$legacy_line" | sed -n 's/.*"status"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
      l_commit="$(printf '%s' "$legacy_line" | sed -n 's/.*"commit"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
      l_ts="$(printf '%s' "$legacy_line" | sed -n 's/.*"timestamp"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
      audit_log reviews "${l_skill:-unknown}" \
        "status=$l_status" "commit=$l_commit" "review_ts=$l_ts" "raw=$legacy_line"
      IMPORTED=1
    done < "$LEGACY_LOG"
    # Append the imported legacy path to the marker (plain state file, not a log).
    printf '%s\n' "$LEGACY_LOG" >> "$MARKER" 2>/dev/null || true
  fi
fi

# ── Read only the native log from here on (legacy already folded in once above) ──
ALL_RECORDS="$( { [ -f "$REVIEWS_LOG" ] && cat "$REVIEWS_LOG"; } 2>/dev/null )"

if [ "$JSON_ONLY" -eq 1 ]; then
  printf '%s\n' "$ALL_RECORDS" | sed '/^$/d'
  exit 0
fi

# ── Emit the raw records (release gate / model can inspect them directly) ──
echo "## Review records (native: $REVIEWS_LOG)"
if [ "$IMPORTED" -eq 1 ]; then
  echo "##                (one-time import folded in legacy records from $LEGACY_LOG)"
fi
if [ -n "$ALL_RECORDS" ]; then
  printf '%s\n' "$ALL_RECORDS" | sed '/^$/d'
else
  echo "NO_REVIEWS"
fi

# ── Compute the verdict: is there a CLEAR <gate_skill> record within N days for HEAD? ──
# A record matches when:
#   - it mentions "skill":"<GATE_SKILL>"  (native records store skill as kind too, but
#     the raw payload — preserved verbatim — always carries "skill":"<...>")
#   - its status is CLEAR/CLEARED/CLEAR (PLAN)/SCOPE LOCKED (treated as clear)
#   - its commit matches the current short HEAD
#   - its timestamp (review_ts / ts / timestamp) is within DAYS of now
# Timestamps are ISO-8601 UTC; string comparison is valid for the freshness cutoff.

_cutoff_iso() {
  date -u -d "$DAYS days ago" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
    date -u -v "-${DAYS}d" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || \
    printf '1970-01-01T00:00:00Z'
}
CUTOFF="$(_cutoff_iso)"

VERDICT_RECORD="$(
  printf '%s\n' "$ALL_RECORDS" | sed '/^$/d' | awk -v skill="$GATE_SKILL" -v head="$HEAD_SHORT" -v cutoff="$CUTOFF" '
    {
      line=$0
      # skill match: native records store the skill as top-level "kind";
      # imported legacy records (and the preserved "raw" payload) carry "skill".
      # Accept the escaped form too (\"skill\":\"...\") since raw is JSON-in-JSON.
      if (index(line, "\"kind\":\"" skill "\"") == 0 \
          && index(line, "\"skill\":\"" skill "\"") == 0 \
          && index(line, "\\\"skill\\\":\\\"" skill "\\\"") == 0) next
      # status: must look CLEAR (CLEAR, CLEARED, CLEAR (PLAN), ENG CLEARED, SCOPE LOCKED).
      # Reject anything negated ("NOT CLEARED", "NOT CLEAR") — substring "CLEAR" alone
      # is not sufficient.
      st=""
      if (match(line, /"status":"[^"]*"/)) st=substr(line, RSTART+10, RLENGTH-11)
      up=toupper(st)
      if (index(up,"NOT ")>0 || index(up,"REVISE")>0) next
      if (index(up,"CLEAR")==0 && index(up,"LOCKED")==0) next
      # commit match (current HEAD); accept records that carry no commit only if HEAD unknown
      cm=""
      if (match(line, /"commit":"[^"]*"/)) cm=substr(line, RSTART+10, RLENGTH-11)
      if (head != "unknown" && cm != "" && cm != head) next
      # freshness: prefer review_ts, then timestamp, then ts
      tsv=""
      if (match(line, /"review_ts":"[^"]*"/)) tsv=substr(line, RSTART+13, RLENGTH-14)
      if (tsv=="" && match(line, /"timestamp":"[^"]*"/)) tsv=substr(line, RSTART+13, RLENGTH-14)
      if (tsv=="" && match(line, /"ts":"[^"]*"/)) tsv=substr(line, RSTART+6, RLENGTH-7)
      if (tsv=="" || tsv=="...") next
      if (tsv < cutoff) next
      print line
    }
  ' | tail -1
)"

echo ""
echo "---VERDICT---"
echo "gate_skill: $GATE_SKILL"
echo "window_days: $DAYS"
echo "current_head: $HEAD_SHORT"
echo "freshness_cutoff: $CUTOFF"

if [ -n "$VERDICT_RECORD" ]; then
  v_status="$(printf '%s' "$VERDICT_RECORD" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
  v_commit="$(printf '%s' "$VERDICT_RECORD" | sed -n 's/.*"commit":"\([^"]*\)".*/\1/p')"
  v_ts="$(printf '%s' "$VERDICT_RECORD" | sed -n 's/.*"review_ts":"\([^"]*\)".*/\1/p')"
  [ -z "$v_ts" ] && v_ts="$(printf '%s' "$VERDICT_RECORD" | sed -n 's/.*"timestamp":"\([^"]*\)".*/\1/p')"
  [ -z "$v_ts" ] && v_ts="$(printf '%s' "$VERDICT_RECORD" | sed -n 's/.*"ts":"\([^"]*\)".*/\1/p')"
  echo "matched_status: ${v_status:-?}"
  echo "matched_commit: ${v_commit:-$HEAD_SHORT}"
  echo "matched_timestamp: ${v_ts:-?}"
  echo "VERDICT: Eng Review CLEAR within ${DAYS} days"
  exit 0
else
  echo "VERDICT: NO fresh Eng Review (no CLEAR ${GATE_SKILL} record within ${DAYS} days for commit ${HEAD_SHORT})"
  exit 3
fi

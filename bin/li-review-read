#!/usr/bin/env bash
# component: lintel-review-read
# implements: ADR-0005, ADR-0024, ADR-0028
# intent: .claude/plans/universal-implementation/packages/P05.md
# constraints: trusted source code, target-owned audit; no regex clearance
# last_intent_review: 2026-09-20
set -euo pipefail
SOURCE_ROOT="${LINTEL_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
skill=inspect
json_only=0
options=()
usage() {
  echo 'Usage: bash li-review-read [--skill <name>] [--expected <context.json>]'
  echo '       [--corroboration <host-or-human.json>] [--days N] [--gate-json | --json]'
  echo 'Exit 0: strict clearance (or raw --json history); 3: blocked; 2: invocation error.'
  echo 'Reads the selected target audit only; --json retains raw historical inspection.'
}
while [ $# -gt 0 ]; do
  case "$1" in
    --skill) [ $# -ge 2 ] || { usage >&2; exit 2; }; skill="$2"; shift 2 ;;
    --expected|--corroboration|--days)
      [ $# -ge 2 ] || { usage >&2; exit 2; }; options+=("$1" "$2"); shift 2 ;;
    --gate-json) options+=("$1"); shift ;;
    --json) json_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "li-review-read: unexpected argument: $1" >&2; exit 2 ;;
  esac
done
python="${LINTEL_PYTHON:-python3}"
if ! "$python" -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
  python=python
fi
"$python" -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1 || {
  echo 'li-review-read: Python 3.9+ is required for strict JSON parsing' >&2; exit 2;
}
helper="$SOURCE_ROOT/bin/li-review-evidence.py"
[ -f "$helper" ] || { echo "li-review-read: trusted evidence helper missing: $helper" >&2; exit 2; }
source "$SOURCE_ROOT/lib/paths.sh"
REPO_ROOT="$(lintel_repo_root)"
[ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT" ] || { echo 'li-review-read: working repository required' >&2; exit 2; }
export LINTEL_REPO_ROOT="$REPO_ROOT"
source "$SOURCE_ROOT/bin/_audit.sh"
log="$(_audit_out_dir reviews)/reviews.jsonl"

if [ "$json_only" -eq 1 ]; then
  if [ -f "$log" ]; then cat "$log"; fi
  exit 0
fi
exec "$python" "$helper" read --repo "$REPO_ROOT" --log "$log" --skill "$skill" "${options[@]}"

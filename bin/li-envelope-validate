#!/usr/bin/env bash
# component: envelope-validator
# implements: ADR-0008, ADR-0027
# intent: .claude/plans/universal-implementation/packages/P04.md
# constraints: read-only; shared structured parser; no rejected payload in diagnostics
# last_intent_review: 2026-09-20
set -uo pipefail

SOURCE_ROOT="${LINTEL_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
if command -v python3 >/dev/null 2>&1; then PYTHON=python3
elif command -v python >/dev/null 2>&1; then PYTHON=python
else echo "ERROR: Python 3.9+ is required for envelope validation" >&2; exit 2
fi
[ -f "$SOURCE_ROOT/lib/envelope_contract.py" ] || {
  echo "ERROR: trusted envelope implementation is missing" >&2
  exit 2
}
exec "$PYTHON" "$SOURCE_ROOT/lib/envelope_contract.py" validate "$@"

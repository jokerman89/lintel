#!/usr/bin/env bash
# Read-only launcher for the portable stdlib swarm CLI.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="$(command -v python3 || command -v python || true)"
if [ -z "$PYTHON" ]; then
  echo "ERROR: Python 3.9+ is required" >&2
  exit 2
fi
exec "$PYTHON" "$ROOT/bin/li-swarm.py" "$@"

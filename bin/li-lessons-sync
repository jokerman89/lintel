#!/usr/bin/env bash
# component: lintel-lessons-sync
# implements: ADR-0005, ADR-0010
# intent: .claude/plans/universal-implementation/packages/P02.md
# constraints: opt-in private sync; retain legacy records and canonical path resolution
# last_intent_review: 2026-09-20
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
if command -v python3 >/dev/null 2>&1; then PYTHON=python3
elif command -v python >/dev/null 2>&1; then PYTHON=python
else echo "ERROR: li-lessons-sync requires Python 3.9+." >&2; exit 2
fi

context=(--)
if [ "${1:---status}" = push ] || [ "${1:---status}" = --push ]; then
  # shellcheck source=../lib/paths.sh
  source "$SCRIPT_DIR/../lib/paths.sh"
  root="$(lintel_repo_root)" || { echo "ERROR: No current repository for lessons sync." >&2; exit 3; }
  lessons="$(lintel_lessons_file)" || { echo "ERROR: Cannot resolve repository lessons." >&2; exit 3; }
  context=(--project-root "$root" --lessons-file "$lessons" --)
fi

exec "$PYTHON" "$SCRIPT_DIR/../lib/private_sync.py" \
  --kind lessons --directory "$LINTEL_HOME/lessons" \
  --binding "$HOME/.lintel-lessons-remote.txt" "${context[@]}" "$@"

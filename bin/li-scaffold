#!/usr/bin/env bash
# li-scaffold — copy scaffolding/01-foundation/* into target repo with repo-specific rendering
#
# Usage:
#   li-scaffold init [--target <path>] [--name <repo-name>] [--pack <pack>] [--mode <type>]
#   li-scaffold check [--target <path>]
#
# Defaults:
#   --target: current working directory
#   --name:   basename of target
#   --pack:   _default (neutral)
#   --mode:   internal-tool

set -euo pipefail

LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
SCAFFOLDING_SRC="${LINTEL_HOME}/scaffolding/01-foundation"
# Absolute sibling-tool dir, resolved BEFORE any cd (a relative $0 would
# otherwise resolve against the target repo after `cd "$TARGET"`).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CMD="${1:-help}"
shift || true

TARGET="$(pwd)"
NAME=""
PACK="_default"
MODE="internal-tool"
VOICE_TIER="internal"
COMPLIANCE_LEVEL="standard"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --target) TARGET="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --pack) PACK="$2"; shift 2 ;;
    --mode) MODE="$2"; shift 2 ;;
    --voice) VOICE_TIER="$2"; shift 2 ;;
    --compliance) COMPLIANCE_LEVEL="$2"; shift 2 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$NAME" ] && NAME="$(basename "$TARGET")"

help() {
  cat <<EOF
li-scaffold — initialize Lintel scaffolding in a repo

Usage:
  li-scaffold init [options]      Initialize scaffolding files
  li-scaffold check [options]     Check current state without modifying

Options:
  --target <path>          Target repo dir (default: cwd)
  --name <repo-name>       Repo name for CLAUDE.md rendering (default: basename of target)
  --pack <pack>            Active pack name (default: _default — neutral)
  --mode <type>            hotfix | internal-tool | mvp | research-dive (default: internal-tool)
  --voice <tier>           voice tier from the active pack (default: internal)
  --compliance <level>     full | standard | minimal (default: standard)

Files created (v5 .claude/ home layout, ADR-0005):
  CLAUDE.md (rendered from template), CORE-PRINCIPLES.md, EVOLUTION.md,
  EVOLUTION-LOG.md, .claude/memory/{MEMORY,lessons,working-state,personas}.md,
  .claude/plans/todo.md, .claude/decisions/{README,TEMPLATE}.md,
  .claude/agents/ (4 templates), .claude/SUBAGENT-GUIDE.md,
  .claude/lintel-layout.yaml, TEMPLATE-skill.md, TEMPLATE-agent.md

Examples:
  cd ~/new-repo && li-scaffold init
  li-scaffold init --target ~/foo --mode mvp
  li-scaffold check
EOF
}

check_source() {
  if [ ! -d "$SCAFFOLDING_SRC" ]; then
    echo "ERROR: Lintel scaffolding source not found at $SCAFFOLDING_SRC" >&2
    echo "Set LINTEL_HOME env var or run Lintel installer first." >&2
    echo "  install: bash <(curl -fsSL https://raw.githubusercontent.com/jokerman89/lintel/main/install/install.sh)" >&2
    exit 3
  fi
}

check_collisions() {
  local collisions=0
  for f in CLAUDE.md CORE-PRINCIPLES.md EVOLUTION.md EVOLUTION-LOG.md; do
    if [ -f "$TARGET/$f" ]; then
      echo "  ⚠ exists: $f"
      collisions=$((collisions+1))
    fi
  done
  echo "$collisions"
}

cmd_check() {
  echo "Lintel scaffold check: $TARGET"
  echo ""
  echo "Scaffolding source: $SCAFFOLDING_SRC"
  if [ -d "$SCAFFOLDING_SRC" ]; then
    echo "  ✓ present"
  else
    echo "  ✗ NOT FOUND"
  fi
  echo ""
  echo "Target state:"
  local existing=0
  for f in CLAUDE.md CORE-PRINCIPLES.md EVOLUTION.md EVOLUTION-LOG.md .claude/memory/lessons.md .claude/decisions/README.md; do
    if [ -e "$TARGET/$f" ]; then
      echo "  ✓ $f"
      existing=$((existing+1))
    else
      echo "  · $f (would create)"
    fi
  done
  echo ""
  if [ "$existing" -eq 0 ]; then
    echo "Verdict: clean target — safe to scaffold."
  elif [ "$existing" -lt 3 ]; then
    echo "Verdict: partial scaffolding — operator may want to merge selectively."
  else
    echo "Verdict: existing scaffolding — backup before re-init."
  fi
}

cmd_init() {
  check_source
  echo "li-scaffold: initializing $TARGET"
  echo "  name=$NAME pack=$PACK mode=$MODE voice=$VOICE_TIER compliance=$COMPLIANCE_LEVEL"
  echo ""

  cd "$TARGET"

  # CLAUDE.md from template (basic substitution)
  if [ -f "CLAUDE.md" ]; then
    echo "  ⚠ CLAUDE.md exists — skipping (use --force to overwrite, future feature)"
  else
    if [ -f "$SCAFFOLDING_SRC/CLAUDE.md.template" ]; then
      # Pure-bash literal substitution — NOT sed (battletest K1: GNU sed's `s///e`
      # executes shell, so a repo dir / --name containing `x/;e <cmd>` was
      # operator-priv RCE). Parameter expansion replaces literally — the value is
      # never interpreted as a program or regex.
      _render="$(cat "$SCAFFOLDING_SRC/CLAUDE.md.template")"
      _render="${_render//\{\{REPO_NAME\}\}/$NAME}"
      _render="${_render//\{\{PACK\}\}/$PACK}"
      _render="${_render//\{\{MODE\}\}/$MODE}"
      _render="${_render//\{\{VOICE_TIER\}\}/$VOICE_TIER}"
      printf '%s\n' "$_render" > CLAUDE.md
      echo "  ✓ CLAUDE.md (rendered)"
    else
      echo "  ⚠ CLAUDE.md.template not found — skipping"
    fi
  fi

  # AGENTS.md — the cross-CLI instruction standard (agents.md). A pointer file:
  # the 7 non-Claude CLIs read it natively; content lives in CLAUDE.md.
  if [ ! -f "AGENTS.md" ] && [ -f "CLAUDE.md" ]; then
    cat > AGENTS.md <<'AGENTSEOF'
# Agent instructions

The canonical instructions for this repo live in [CLAUDE.md](CLAUDE.md) — read it fully.
It covers the session-start ritual, the memory map (.claude/memory/, .claude/decisions/,
.claude/plans/), workflow orchestration, and auto-mode boundaries. This file exists so
every AGENTS.md-aware CLI finds them natively.
AGENTSEOF
    echo "  ✓ AGENTS.md (pointer)"
  fi

  # .claude/rules/ — path-scoped rules (Claude Code loads paths:-scoped rules
  # natively; the session-digest hook lists them as an index for other CLIs)
  mkdir -p .claude/rules
  if [ ! -f ".claude/rules/README.md" ]; then
    cat > .claude/rules/README.md <<'RULESEOF'
# Path-scoped rules

One rule per file. Claude Code loads PROJECT-level rules (`./.claude/rules/`) conditioned on
`paths:` frontmatter — globs MUST be quoted (`"src/api/**"`, unquoted globs fail silently) and
user-level (`~/.claude/rules/`) path-scoping is broken as of mid-2026. Other CLIs see the rule
titles in the session digest and read on demand.

```markdown
---
paths:
  - "src/api/**"
---
The API layer never throws raw exceptions across the boundary — wrap in ApiError.
```

Promote a lesson here when it is path-specific (cheaper than loading it every session).
RULESEOF
    echo "  ✓ .claude/rules/README.md"
  fi

  # Copy static templates
  for f in CORE-PRINCIPLES.md EVOLUTION.md EVOLUTION-LOG.md TEMPLATE-skill.md TEMPLATE-agent.md; do
    if [ -f "$SCAFFOLDING_SRC/$f" ] && [ ! -f "$f" ]; then
      cp "$SCAFFOLDING_SRC/$f" .
      echo "  ✓ $f"
    fi
  done

  # .claude/memory/ + .claude/plans/ + .claude/decisions/ (v5 layout, ADR-0005)
  mkdir -p .claude/memory .claude/plans .claude/decisions
  for f in lessons.md working-state.md personas.md personas-example.md; do
    if [ -f "$SCAFFOLDING_SRC/.claude/memory/$f" ] && [ ! -f ".claude/memory/$f" ]; then
      cp "$SCAFFOLDING_SRC/.claude/memory/$f" .claude/memory/
      echo "  ✓ .claude/memory/$f"
    fi
  done
  if [ -f "$SCAFFOLDING_SRC/.claude/plans/todo.md" ] && [ ! -f ".claude/plans/todo.md" ]; then
    cp "$SCAFFOLDING_SRC/.claude/plans/todo.md" .claude/plans/
    echo "  ✓ .claude/plans/todo.md"
  fi
  for f in "$SCAFFOLDING_SRC"/.claude/decisions/*.md; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    if [ ! -f ".claude/decisions/$name" ]; then
      cp "$f" .claude/decisions/
      echo "  ✓ .claude/decisions/$name"
    fi
  done

  # Layout stamping (marker, .gitignore, MEMORY.md seed, auto-memory pointer) —
  # one implementation: the idempotent migration tool no-ops the moves on a
  # fresh repo and stamps the rest.
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    "$SCRIPT_DIR/li-migrate-claude-home" --repo . | sed 's/^/  /'
  else
    echo "  ⚠ not a git repo — skipped layout marker/auto-memory stamping (run li-migrate-claude-home after git init)"
  fi

  # .claude/
  mkdir -p .claude/agents
  for f in "$SCAFFOLDING_SRC"/.claude/agents/*.md; do
    [ -f "$f" ] || continue
    name=$(basename "$f")
    if [ ! -f ".claude/agents/$name" ]; then
      cp "$f" .claude/agents/
      echo "  ✓ .claude/agents/$name"
    fi
  done
  if [ -f "$SCAFFOLDING_SRC/.claude/SUBAGENT-GUIDE.md" ] && [ ! -f ".claude/SUBAGENT-GUIDE.md" ]; then
    cp "$SCAFFOLDING_SRC/.claude/SUBAGENT-GUIDE.md" .claude/
    echo "  ✓ .claude/SUBAGENT-GUIDE.md"
  fi

  echo ""
  echo "li-scaffold: done."
  echo ""
  echo "Next steps:"
  echo "  1. Review CLAUDE.md and customize project-specific sections."
  echo "  2. Edit .claude/memory/personas.md with project-specific personas."
  echo "  3. Install Lintel plugin for your CLI:"
  echo "       Claude Code:    /plugin marketplace add jokerman89/lintel"
  echo "                       /plugin install li@jokerman-lintel"
  echo "       Codex:          /plugins → search li → Install"
  echo "       Cursor:         /add-plugin li"
  echo "       Gemini:         gemini extensions install https://github.com/jokerman89/lintel"
  echo "  4. Run /li:welcome in your CLI — detects your CLI, shows its honest tier, runs a dry-run cycle."
  echo "  5. git add -A && git commit -m 'chore: scaffold Lintel base'"
  echo ""
}

case "$CMD" in
  init) cmd_init ;;
  check) cmd_check ;;
  help|--help|-h) help ;;
  *) help; exit 2 ;;
esac

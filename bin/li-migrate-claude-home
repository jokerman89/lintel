#!/usr/bin/env bash
# component: claude-home-migration-entry
# implements: ADR-0005, ADR-0030
# intent: .claude/plans/universal-implementation/packages/P10.md
# constraints: verified file transaction; no Git staging or implicit rollback
# last_intent_review: 2026-09-20
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE="${LINTEL_SOURCE_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd -P)}"
exec bash "$SOURCE/bin/li-lifecycle" migrate "$@"

#!/usr/bin/env bash
# component: lintel-roles-sync
# implements: ADR-0010
# intent: .claude/plans/universal-implementation/packages/P02.md
# constraints: opt-in private sync; preserve local content on rebind and forget
# last_intent_review: 2026-09-20
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
if command -v python3 >/dev/null 2>&1; then PYTHON=python3
elif command -v python >/dev/null 2>&1; then PYTHON=python
else echo "ERROR: li-roles-sync requires Python 3.9+." >&2; exit 2
fi

exec "$PYTHON" "$SCRIPT_DIR/../lib/private_sync.py" \
  --kind roles --directory "$LINTEL_HOME/roles/private" \
  --binding "$HOME/.lintel-roles-remote.txt" -- "$@"

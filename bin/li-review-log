#!/usr/bin/env bash
# component: lintel-review-log
# implements: ADR-0005, ADR-0024, ADR-0028
# intent: .claude/plans/universal-implementation/packages/P05.md
# constraints: trusted source code, target-owned audit; legacy history is not clearance
# last_intent_review: 2026-09-20
set -euo pipefail
SOURCE_ROOT="${LINTEL_SOURCE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
usage() {
  echo 'Usage: bash li-review-log <JSON> | --file <review.json> [--history]'
  echo 'Strict version-2 evidence uses the shared contract. --history is inspection-only.'
}
input=()
history=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --file) [ $# -ge 2 ] && [ "${#input[@]}" -eq 0 ] || { usage >&2; exit 2; }
            input=(--file "$2"); shift 2 ;;
    --history) history=(--history); shift ;;
    -*) echo "li-review-log: unknown flag: $1" >&2; exit 2 ;;
    *) [ "${#input[@]}" -eq 0 ] || { echo 'li-review-log: one input required' >&2; exit 2; }
       input=(--input "$1"); shift ;;
  esac
done
[ "${#input[@]}" -gt 0 ] || { usage >&2; exit 2; }
python="${LINTEL_PYTHON:-python3}"
if ! "$python" -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
  python=python
fi
"$python" -c 'import sys; assert sys.version_info >= (3, 9)' >/dev/null 2>&1 || {
  echo 'li-review-log: Python 3.9+ is required for strict JSON parsing' >&2; exit 2;
}
helper="$SOURCE_ROOT/bin/li-review-evidence.py"
[ -f "$helper" ] || { echo "li-review-log: trusted evidence helper missing: $helper" >&2; exit 2; }
source "$SOURCE_ROOT/lib/paths.sh"
REPO_ROOT="$(lintel_repo_root)"
[ -n "$REPO_ROOT" ] && [ -d "$REPO_ROOT" ] || { echo 'li-review-log: working repository required' >&2; exit 2; }
export LINTEL_REPO_ROOT="$REPO_ROOT"
validated="$("$python" "$helper" log-input --repo "$REPO_ROOT" "${input[@]}" "${history[@]}")" || exit 1
skill="${validated%%$'\n'*}"; validated="${validated#*$'\n'}"
status="${validated%%$'\n'*}"; validated="${validated#*$'\n'}"
commit="${validated%%$'\n'*}"; validated="${validated#*$'\n'}"
format="${validated%%$'\n'*}"; raw="${validated#*$'\n'}"
source "$SOURCE_ROOT/bin/_audit.sh"
log="$(_audit_out_dir reviews)/reviews.jsonl"
offset=0
if [ -f "$log" ]; then offset="$(wc -c < "$log" | tr -d '[:space:]')"; fi
audit_log reviews "$skill" "status=$status" "commit=$commit" "format=$format" "raw=$raw"
printf '%s' "$raw" | "$python" "$helper" audit-check --log "$log" --offset "$offset" || exit 1
echo "li-review-log: recorded $skill status=$status commit=$commit -> $log"

#!/usr/bin/env bash
# component: isolated-bisect
# implements: ADR-0034
# intent: .claude/plans/v2-findings/plan.md
# constraints: authorized local source and new owned trial; no hook/config overrides
# last_intent_review: 2026-10-04
# lintel-isolated-bisect
set -euo pipefail
source_repo="${1:?source repository}"
reproducer="${4:?trusted standalone reproducer path}"
trial="${5:?new authorized trial directory}"
# git -C must not give worktree creation a different base than later commands.
trial_git_options=()
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    command -v cygpath >/dev/null 2>&1 || { echo 'Native Windows path conversion is unavailable.' >&2; exit 2; }
    for operand in source_repo reproducer trial; do
      normalized="$(cygpath -am -- "${!operand}")" || { echo 'Native path conversion failed.' >&2; exit 2; }
      case "$normalized" in
        [[:alpha:]]:/*|//?*) ;;
        *) echo 'Expected a native absolute Windows path.' >&2; exit 2 ;;
      esac
      printf -v "$operand" '%s' "$normalized"
    done
    trial_git_options=(-c core.longpaths=true)
    ;;
  *)
    for operand in source_repo reproducer trial; do
      case "${!operand}" in
        /*) ;;
        *) printf -v "$operand" '%s/%s' "$PWD" "${!operand}" ;;
      esac
    done
    ;;
esac
bad=$(git -C "$source_repo" rev-parse --verify --end-of-options "${2:?bad ref}^{commit}")
good=$(git -C "$source_repo" rev-parse --verify --end-of-options "${3:?good ref}^{commit}")
git -C "$source_repo" merge-base --is-ancestor "$good" "$bad"
[ ! -e "$trial" ] && [ ! -L "$trial" ] || { echo 'Trial path already exists.' >&2; exit 1; }
git "${trial_git_options[@]}" -C "$source_repo" worktree add --detach "$trial" "$bad"
finish_bisect() {
  rc=$?
  trap - EXIT HUP INT TERM
  if ! git "${trial_git_options[@]}" -C "$trial" bisect reset; then
    echo "Bisect cleanup failed; preserve and inspect the trial: $trial" >&2
    rc=1
  fi
  exit "$rc"
}
trap finish_bisect EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
git "${trial_git_options[@]}" -C "$trial" bisect start "$bad" "$good"
git "${trial_git_options[@]}" -C "$trial" bisect run bash "$reproducer"
git "${trial_git_options[@]}" -C "$trial" bisect log

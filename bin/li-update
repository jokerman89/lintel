#!/usr/bin/env bash
# li-update — update Lintel plugin across all detected CLIs
#
# Usage: li-update [--dry-run]
# component: li-update
# implements: ADR-0008
# intent: .claude/plans/universal-implementation/packages/P01.md
# constraints: preserve subprocess failure while continuing independent hosts
# last_intent_review: 2026-09-20

set -euo pipefail

DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --help|-h)
      cat <<EOF
li-update — update Lintel plugin across detected CLIs

What it does:
  1. Detects which CLIs are installed and have Lintel plugin
  2. Runs each CLI's update command in sequence
  3. Updates scaffolding source at \$LINTEL_HOME

Options:
  --dry-run    Show what would be done, don't execute

Per-CLI update commands run:
  claude code:    /plugin update li@jokerman-lintel   (operator-driven inside CLI)
  codex:          /plugins (search li, click update)         (operator-driven)
  cursor:         /update-plugin li                          (operator-driven)
  gemini:         gemini extensions update li
  copilot cli:    copilot plugin update li@jokerman-lintel
  droid:          droid plugin update li

Note: Claude Code, Codex, and Cursor update via in-CLI commands —
      this script just lists them for you to run.
      Copilot falls back to a forced install only when its update fails.
      An unrecovered source update, host update or discovery failure exits nonzero.
EOF
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

LINTEL_HOME="${LINTEL_HOME:-$HOME/.lintel}"
UPDATE_STATUS=0

record_failure() {
  if [ "$UPDATE_STATUS" -eq 0 ]; then UPDATE_STATUS="$1"; fi
}

run() {
  if [ "$DRY_RUN" = "1" ]; then
    echo "  [dry-run] $*"
  else
    echo "  → $*"
    local status
    if "$@"; then
      return 0
    else
      status=$?
      printf '    WARN: failed (exit %s): %s\n' "$status" "$*" >&2
      return "$status"
    fi
  fi
}

plugin_installed() {
  local plugins status
  if plugins=$("$@" 2>&1); then
    printf '%s\n' "$plugins" | grep -qi "li"
  else
    status=$?
    printf '  WARN: discovery failed (exit %s): %s\n%s\n' "$status" "$*" "$plugins" >&2
    record_failure "$status"
    return 1
  fi
}

echo "li-update — updating across CLIs"
echo ""

# 1. Update scaffolding source
echo "## Scaffolding source ($LINTEL_HOME)"
if [ -d "$LINTEL_HOME/.git" ]; then
  if [ "$DRY_RUN" = "1" ]; then
    echo "  [dry-run] cd $LINTEL_HOME && git fetch && git pull --ff-only"
  else
    if (cd "$LINTEL_HOME" && run git fetch -q origin && run git pull --ff-only -q); then
      echo "  ✓ updated"
    else
      record_failure "$?"
      echo "  WARN: scaffolding update failed (manual intervention may be needed)" >&2
    fi
  fi
else
  echo "  ⚠ $LINTEL_HOME not a git repo — skipping scaffolding update"
  echo "    Recommend: git clone jokerman89/lintel $LINTEL_HOME"
fi
echo ""

# 2. Per-CLI plugin update
echo "## Per-CLI plugin updates"

# Gemini (scriptable)
if command -v gemini >/dev/null 2>&1; then
  if plugin_installed gemini extensions list; then
    echo "gemini:"
    run gemini extensions update li || record_failure "$?"
  fi
fi

# Copilot CLI (scriptable)
if command -v copilot >/dev/null 2>&1; then
  if plugin_installed copilot plugin list; then
    echo "copilot cli:"
    run copilot plugin update li@jokerman-lintel || \
      run copilot plugin install li@jokerman-lintel --force || record_failure "$?"
  fi
fi

# Droid (scriptable)
if command -v droid >/dev/null 2>&1; then
  if plugin_installed droid plugin list; then
    echo "droid:"
    run droid plugin update li || record_failure "$?"
  fi
fi

# Claude / Codex / Cursor — operator-driven (no CLI update command)
echo ""
echo "## Operator-driven updates (run inside each CLI):"
if command -v claude >/dev/null 2>&1; then
  echo "  claude code:  /plugin update li@jokerman-lintel"
fi
if command -v codex >/dev/null 2>&1; then
  echo "  codex:        /plugins → search li → Update"
fi
if command -v cursor >/dev/null 2>&1; then
  echo "  cursor:       /update-plugin li (in Agent chat)"
fi

echo ""
if [ "$UPDATE_STATUS" -ne 0 ]; then
  echo "ERROR: one or more updates or discovery commands failed (exit $UPDATE_STATUS)." >&2
fi
echo "Run 'li-doctor' afterward to verify all CLIs on latest version."
exit "$UPDATE_STATUS"

        "shipped": {
          "producers": ["instruction-only:skills/ship/SKILL.md"],
          "records_when": ["end"],
          "fields": ["branch", "commit_range", "ai_assistance", "phases", "audience", "voice_tier", "gates_passed"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "observation", "check": "performed"}
          ]
        }
      }
    },
    "qa-fixes": {
      "kinds": {
        "auto_fix": {
          "producers": ["instruction-only:skills/qa/SKILL.md"],
          "records_when": ["always"],
          "fields": ["file", "fix_kind"],
          "aliases": {"target_path": ["file"]},
          "rules": [
            {"when": {}, "class": "observation", "check": "performed"}
          ]
        }
      }
    },
    "reviews": {
      "delegated": "li-review-read",
      "producers": ["bin/li-review-log"],
      "fields": ["status", "commit", "format", "raw"],
      "note": "Kinds are reviewed skill names. The generic reader counts lines and never classifies verdicts or parses review content.",
      "kinds": {}
    },
    "self-test": {
      "kinds": {
        "smoke": {
          "producers": ["bin/_audit.sh"],
          "records_when": ["always"],
          "fields": ["key1", "key2"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "observation", "check": "performed"}
          ]
        }
      }
    },
    "usage-skill": {
      "kinds": {
        "invocation": {
          "producers": ["instruction-only:skills/usage-log/SKILL.md"],
          "records_when": ["always"],
          "fields": ["skill", "mode", "tokens_est", "cli"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "observation", "check": "performed"}
          ]
        }
      }
    }
  },
  "dynamic": [
    {
      "call_site": "lib/brief-forge.sh:_brief_forge_audit",
      "category": "brief-forge",
      "kind_pattern": "^brief_forge_(blocked|bypassed)$",
      "kinds": ["brief_forge_blocked", "brief_forge_bypassed"],
      "fields_dynamic": true,
      "fields": ["reason", "audit_receipt", "evaluator"],
      "note": "audit_log brief-forge \"brief_forge_$decision\" \"${fields[@]}\""
    },
    {
      "call_site": "lib/pack-resolver.sh:_resolver_audit",
      "category": "pack-resolver",
      "kind_pattern": "^pack_resolver_(info|warn|fail|context_bound|context_rebound)$",
      "kinds": ["pack_resolver_context_bound", "pack_resolver_context_rebound", "pack_resolver_fail", "pack_resolver_info", "pack_resolver_warn"],
      "fields": ["msg"],
      "note": "audit_log \"pack-resolver\" \"pack_resolver_${level}\" \"msg=...\""
    },
    {
      "call_site": "bin/_jobs.sh:_jobs_audit",
      "wrapper": "_jobs_audit",
      "category_pattern": "^jobs$",
      "kind_pattern": "^job_[a-z_]+$",
      "fields_dynamic": true,
      "note": "forwards \"$@\"; each literal _jobs_audit call is catalogued as its caller's producer"
    },
    {
      "call_site": "bin/li-review-log",
      "category": "reviews",
      "kind_pattern": "^[a-z][a-z0-9-]*$",
      "delegated_kinds": true,
      "fields": ["status", "commit", "format", "raw"],
      "note": "the kind is the reviewed skill name; li-review-read owns review interpretation"
    }
  ],
  "non_recording_hooks": [
    {
      "hook": "context-bloat-warn",
      "reason": "prints threshold warnings only; it never calls audit_log, so no record is expected"
    }
  ]
}

{
  "schema_version": 1,
  "catalog_version": 1,
  "description": "Versioned producer catalog for audit_log records. The envelope is ts, kind, operator, cycle_id; every listed field is a string. bin/li-events.py is the structured reader. A record is an observation of what a producer wrote, never proof of host enforcement; an absent record is unobserved, not evidence that nothing ran.",
  "envelope": ["ts", "kind", "operator", "cycle_id"],
  "vocabulary": {
    "records_when": ["always", "start", "end", "finding", "block", "override", "unavailable", "failure"],
    "class": ["observation", "finding", "block_decision", "override", "receipt", "diagnostic"],
    "check": ["performed", "not_performed", "unknown"]
  },
  "wrappers": [
    {
      "name": "_jobs_audit",
      "path": "bin/_jobs.sh",
      "call_form": "_jobs_audit <category> <kind> [key=value ...]"
    }
  ],
  "categories": {
    "alias-resolution": {
      "kinds": {
        "env_var": {
          "producers": ["bin/_aliases.sh:resolve_env_var"],
          "records_when": ["always"],
          "fields": ["old", "new", "context"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "diagnostic", "check": "performed"}
          ]
        }
      }
    },
    "brief-forge": {
      "kinds": {
        "brief_forge_blocked": {
          "producers": ["lib/brief-forge.sh:_brief_forge_audit"],
          "records_when": ["block", "failure"],
          "fields": ["reason", "audit_receipt", "evaluator"],
          "aliases": {},
          "rules": [
            {
              "when": {"reason": ["invalid_policy", "unknown_evaluator", "invalid_content", "evaluation_failed"]},
              "class": "receipt",
              "check": "not_performed"
            },
            {"when": {"reason": "release_failed"}, "class": "receipt", "check": "performed"},
            {"when": {}, "class": "receipt", "check": "unknown"}
          ]
        },
        "brief_forge_bypassed": {
          "producers": ["lib/brief-forge.sh:_brief_forge_audit"],
          "records_when": ["override"],
          "fields": ["reason", "audit_receipt"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "receipt", "check": "not_performed"}
          ]
        },
        "brief_forge_emitted": {
          "producers": ["lib/brief-forge.sh:forge_handoff"],
          "records_when": ["end"],
          "fields": ["decision", "envelope_id", "envelope_digest", "content_type", "score", "evaluators_run"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "receipt", "check": "performed"}
          ]
        }
      }
    },
    "capture": {
      "kinds": {
        "vault_init": {
          "producers": ["bin/li-vault-init"],
          "records_when": ["end"],
          "fields": ["vault", "repo"],
          "aliases": {},
          "rules": [
            {"when": {}, "class": "observation", "check": "performed"}
          ]
        },
        "vault_sink_skipped": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lintel.dev/schemas/review-v1.json",
  "title": "Lintel content-bound review and control evidence",
  "$ref": "#/$defs/review",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nullableText": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "status": {"enum": ["pass", "fail", "unverified", "error"]},
    "legacyStatus": {"enum": ["CLEAR", "CLEARED", "CLEAR (PLAN)", "ENG CLEARED", "SCOPE LOCKED", "NOT CLEAR", "NOT CLEARED", "REVISE", "BLOCKED", "NEEDS_CONTEXT", "PASS", "FAIL"]},
    "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "nonemptyStrings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["id", "context"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "context": {"$ref": "#/$defs/text"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "version", "applicability", "jurisdiction", "actor", "effective_date"],
      "properties": {
        "source": {"$ref": "#/$defs/nullableText"}, "version": {"$ref": "#/$defs/nullableText"},
        "applicability": {"$ref": "#/$defs/text"}, "jurisdiction": {"$ref": "#/$defs/nullableText"},
        "actor": {"$ref": "#/$defs/nullableText"}, "effective_date": {"$ref": "#/$defs/nullableText"}
      }
    },
    "requiredPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "status", "source", "version", "applicability"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["loaded", "not_required", "unverified", "error"]},
        "source": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "version": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "applicability": {"$ref": "#/$defs/applicability"}, "reason": {"$ref": "#/$defs/text"}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "requirement", "applicability", "status", "reason", "policy", "evidence", "observation"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["check", "tests", "browser", "contrast", "policy"]},
        "requirement": {"enum": ["mandatory", "advisory"]},
        "applicability": {"$ref": "#/$defs/applicability"}, "status": {"$ref": "#/$defs/status"},
        "reason": {"$ref": "#/$defs/text"}, "policy": {"$ref": "#/$defs/policy"},
        "evidence": {"$ref": "#/$defs/strings"}, "observation": {"type": "object"},
        "advisory_score": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "evidenceFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "evidenceFiles": {"type": "array", "items": {"$ref": "#/$defs/evidenceFile"}, "uniqueItems": true},
    "acceptanceRef": {
      "anyOf": [
        {"$ref": "#/$defs/text"},
        {
          "type": "object", "additionalProperties": false, "required": ["path", "start", "end"],
          "properties": {
            "path": {"$ref": "#/$defs/text"}, "start": {"$ref": "#/$defs/text"}, "end": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "acceptanceFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "start", "end", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "start": {"$ref": "#/$defs/nullableText"},
        "end": {"$ref": "#/$defs/nullableText"}, "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["work_map", "map_digest", "package_id", "leaf_ids", "acceptance_paths", "acceptance_manifest", "acceptance_digest"],
      "properties": {
        "work_map": {"$ref": "#/$defs/nullableText"},
        "map_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "package_id": {"$ref": "#/$defs/text"}, "leaf_ids": {"$ref": "#/$defs/nonemptyStrings"},
        "acceptance_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/acceptanceRef"}},
        "acceptance_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptanceFile"}},
        "acceptance_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "fileState": {
      "type": "object", "additionalProperties": false, "required": ["kind", "mode", "sha256"],
      "properties": {
        "kind": {"enum": ["absent", "file", "symlink"]},
        "mode": {"enum": ["000000", "100644", "100755", "120000"]},
        "sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["path", "base", "head", "index", "worktree"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "base": {"$ref": "#/$defs/fileState"},
        "head": {"$ref": "#/$defs/fileState"}, "index": {"$ref": "#/$defs/fileState"},
        "worktree": {"$ref": "#/$defs/fileState"}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "head", "selection", "record_path", "entries", "result_digest"],
      "properties": {
        "base": {"$ref": "#/$defs/commit"}, "head": {"$ref": "#/$defs/commit"},
        "selection": {"$ref": "#/$defs/nonemptyStrings"}, "record_path": {"$ref": "#/$defs/nullableText"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
        "result_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "context_id", "generation", "digest", "name", "version"],
      "properties": {
        "schema_version": {"const": 1}, "context_id": {"$ref": "#/$defs/text"},
        "generation": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "work", "snapshot", "profile", "attempt_id", "builder", "independence_required", "purpose", "required_policy", "required_controls"],
      "properties": {
        "schema_version": {"const": 1}, "work": {"$ref": "#/$defs/work"}, "snapshot": {"$ref": "#/$defs/snapshot"},
        "profile": {"anyOf": [{"$ref": "#/$defs/profile"}, {"type": "null"}]},
        "attempt_id": {"$ref": "#/$defs/text"}, "builder": {"$ref": "#/$defs/actor"},
        "independence_required": {"type": "boolean"}, "purpose": {"enum": ["implementation", "verification_only"]},
        "required_policy": {"$ref": "#/$defs/requiredPolicy"}, "required_controls": {"$ref": "#/$defs/nonemptyStrings"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "skill", "status", "timestamp", "reason", "context", "reviewer", "provenance", "controls", "coverage", "evidence"],
      "properties": {
        "schema_version": {"const": 1}, "skill": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "status": {"$ref": "#/$defs/status"}, "timestamp": {"$ref": "#/$defs/text"},
        "reason": {"$ref": "#/$defs/text"}, "context": {"$ref": "#/$defs/context"},
        "reviewer": {"$ref": "#/$defs/actor"}, "provenance": {"const": "declared"},
        "controls": {"$ref": "#/$defs/controls"},
        "coverage": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonemptyStrings"}},
        "evidence": {"$ref": "#/$defs/evidenceFiles"}
      }
    },
    "corroboration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "source", "reference", "record_digest", "attempt_id", "builder", "reviewer"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"enum": ["host", "human"]},
        "source": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"},
        "record_digest": {"$ref": "#/$defs/digest"}, "attempt_id": {"$ref": "#/$defs/text"},
        "builder": {"$ref": "#/$defs/actor"}, "reviewer": {"$ref": "#/$defs/actor"}
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "context_digest", "controls", "evidence"],
      "properties": {
        "schema_version": {"const": 1}, "context_digest": {"$ref": "#/$defs/digest"},
        "controls": {"$ref": "#/$defs/controls"}, "evidence": {"$ref": "#/$defs/evidenceFiles"}
      }
    }
  }
}

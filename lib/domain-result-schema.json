{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lintel:domain-result:1",
  "title": "Non-clearing domain request and checkpoint observations",
  "anyOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/checkpoint"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "domain": {"enum": ["ta", "da", "sc", "dh", "tq"]},
    "receiver": {
      "type": "object", "additionalProperties": false, "required": ["role", "mode"],
      "properties": {
        "role": {"$ref": "review-schema.json#/$defs/text"},
        "mode": {"$ref": "review-schema.json#/$defs/text"}
      }
    },
    "fileState": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false, "required": ["sha256", "size", "mode"],
          "properties": {
            "sha256": {"$ref": "review-schema.json#/$defs/digest"},
            "size": {"type": "integer", "minimum": 0, "maximum": 2097152},
            "mode": {"type": "integer", "minimum": 0, "maximum": 511}
          }
        }
      ]
    },
    "expectedState": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {"state": {"$ref": "#/$defs/fileState"}}
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["path", "expected_state"],
      "properties": {
        "path": {"$ref": "review-schema.json#/$defs/text"},
        "expected_state": {"$ref": "#/$defs/fileState"}
      }
    },
    "checkpointSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "receiver", "control_ids", "artifacts", "start", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "receiver": {"$ref": "#/$defs/receiver"},
        "control_ids": {"$ref": "review-schema.json#/$defs/nonemptyStrings"},
        "artifacts": {"$ref": "review-schema.json#/$defs/strings"},
        "start": {"$ref": "#/$defs/slot"}, "result": {"$ref": "#/$defs/slot"}
      }
    },
    "domainSpec": {
      "type": "object", "additionalProperties": false, "required": ["id", "checkpoints"],
      "properties": {
        "id": {"$ref": "#/$defs/domain"},
        "checkpoints": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/checkpointSpec"}}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "operation_id", "iteration", "input_context", "domains", "advisory_preferences", "release_clearance"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "domain-request"},
        "operation_id": {"$ref": "#/$defs/identifier"},
        "iteration": {"type": "integer", "minimum": 1, "maximum": 9999},
        "input_context": {"$ref": "review-schema.json#/$defs/context"},
        "domains": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/domainSpec"}},
        "advisory_preferences": {"type": "object"},
        "release_clearance": {"const": false}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "request", "domain", "checkpoint", "receiver", "producer", "provenance", "release_clearance"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "domain-checkpoint"},
        "request": {"$ref": "review-schema.json#/$defs/evidenceFile"},
        "domain": {"$ref": "#/$defs/domain"}, "checkpoint": {"$ref": "#/$defs/identifier"},
        "receiver": {"$ref": "#/$defs/receiver"},
        "producer": {"$ref": "review-schema.json#/$defs/actor"},
        "provenance": {"const": "declared"}, "release_clearance": {"const": false}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["requirement", "rationale", "artifact"],
      "properties": {
        "requirement": {"$ref": "review-schema.json#/$defs/text"},
        "rationale": {"$ref": "review-schema.json#/$defs/text"},
        "artifact": {"$ref": "review-schema.json#/$defs/text"}
      }
    },
    "next": {
      "type": "object", "additionalProperties": false, "required": ["owner", "action"],
      "properties": {
        "owner": {"$ref": "review-schema.json#/$defs/text"},
        "action": {"$ref": "review-schema.json#/$defs/text"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "kind", "request", "domain", "checkpoint", "receiver", "producer", "provenance", "release_clearance", "start", "status", "reason", "controls", "evidence", "artifacts", "decisions", "limitations", "next"],
      "properties": {
        "schema_version": {"const": 1}, "kind": {"const": "domain-result"},
        "request": {"$ref": "review-schema.json#/$defs/evidenceFile"},
        "domain": {"$ref": "#/$defs/domain"}, "checkpoint": {"$ref": "#/$defs/identifier"},
        "receiver": {"$ref": "#/$defs/receiver"},
        "producer": {"$ref": "review-schema.json#/$defs/actor"},
        "provenance": {"const": "declared"}, "release_clearance": {"const": false},
        "start": {"$ref": "review-schema.json#/$defs/evidenceFile"},
        "status": {"$ref": "review-schema.json#/$defs/status"},
        "reason": {"$ref": "review-schema.json#/$defs/text"},
        "controls": {"$ref": "review-schema.json#/$defs/controls"},
        "evidence": {"$ref": "review-schema.json#/$defs/evidenceFiles"},
        "artifacts": {"$ref": "review-schema.json#/$defs/evidenceFiles"},
        "decisions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/decision"}},
        "limitations": {"$ref": "review-schema.json#/$defs/strings"},
        "next": {"$ref": "#/$defs/next"},
        "advisory_score": {"type": "number", "minimum": 0, "maximum": 100}
      }
    }
  }
}

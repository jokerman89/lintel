{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lintel:design:1",
  "title": "Direct design compatibility contract; not execution or review clearance",
  "anyOf": [
    {"$ref": "#/$defs/frontend"}, {"$ref": "#/$defs/pipeline"},
    {"$ref": "#/$defs/typography"}, {"$ref": "#/$defs/motion"}, {"$ref": "#/$defs/shader"}
  ],
  "x-dimensions": {
    "typography": "typography_hierarchy",
    "motion": "motion_coherence",
    "shader": "shader_perf_budget",
    "accessibility": "accessibility_wcag",
    "brand": "brand_conformance",
    "responsive": "responsive_fidelity"
  },
  "x-renderers": {
    "single-file": {"skill": "generate-web", "option": "--variant", "value": "single-file", "stacks": ["html"]},
    "nextjs": {"skill": "generate-web", "option": "--variant", "value": "nextjs-scaffold", "stacks": ["next-app"]},
    "app": {"skill": "generate-app", "option": "--stack", "stacks": ["next-app", "vite-react", "svelte-kit"]}
  },
  "$defs": {
    "text": {"$ref": "https://lintel.dev/schemas/review-v2.json#/$defs/text"},
    "stack": {"enum": ["html", "next-app", "vite-react", "svelte-kit", "vue"]},
    "files": {"$ref": "https://lintel.dev/schemas/review-v2.json#/$defs/evidenceFiles"},
    "file": {"$ref": "https://lintel.dev/schemas/review-v2.json#/$defs/evidenceFile"},
    "frontend": {
      "allOf": [{"$ref": "#/$defs/design"}],
      "type": "object", "required": ["schema_version", "source", "target_format", "typography", "motion", "shader", "component_libraries", "layout_grammar", "interaction_signature", "visual_thesis", "voice_tier"],
      "properties": {
        "schema_version": {"const": 1}, "source": {"const": "frontend-design"},
        "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "pipeline": {
      "type": "object", "required": ["version", "palette", "fonts", "per_format"],
      "properties": {
        "version": {"const": "1.0"}, "schema_version": {"const": 1}, "source": {"const": "pipeline"},
        "palette": {"type": "object"}, "fonts": {"type": "object"}, "per_format": {"type": "object"},
        "web_design": {"$ref": "#/$defs/design"}, "binding": {"$ref": "#/$defs/binding"}
      }
    },
    "font": {
      "type": "object", "required": ["role", "family", "fallback_stack"],
      "properties": {
        "role": {"enum": ["heading", "body", "mono"]}, "family": {"$ref": "#/$defs/text"},
        "fallback_stack": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "typography": {
      "type": "object", "required": ["schema_version", "font_stacks", "size_scale"],
      "properties": {
        "schema_version": {"const": 1},
        "font_stacks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/font"}},
        "size_scale": {
          "type": "object", "required": ["base_px", "ratio"],
          "properties": {"base_px": {"type": "number", "minimum": 1}, "ratio": {"type": "number", "minimum": 1}}
        }
      }
    },
    "library": {
      "type": "object", "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/text"}}
    },
    "motion": {
      "type": "object", "required": ["schema_version", "libraries", "key_animations", "perf_budget"],
      "properties": {
        "schema_version": {"const": 1}, "mode": {"enum": ["none", "css", "library"]},
        "libraries": {"type": "array", "items": {"$ref": "#/$defs/library"}},
        "key_animations": {"type": "array", "items": {"type": "object"}},
        "perf_budget": {
          "type": "object", "required": ["fallback_for_prefers_reduced_motion"],
          "properties": {"fallback_for_prefers_reduced_motion": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "shader": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "required": ["schema_version", "visual_thesis", "library"],
          "properties": {
            "schema_version": {"const": 1}, "visual_thesis": {"$ref": "#/$defs/text"},
            "library": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/library"}]}
          }
        }
      ]
    },
    "design": {
      "type": "object", "required": ["target_format", "typography", "motion", "shader", "component_libraries", "layout_grammar", "interaction_signature", "visual_thesis", "voice_tier"],
      "properties": {
        "target_format": {"enum": ["single-file", "nextjs", "app"]},
        "typography": {"$ref": "#/$defs/typography"}, "motion": {"$ref": "#/$defs/motion"},
        "shader": {"$ref": "#/$defs/shader"},
        "component_libraries": {"type": "array", "items": {"$ref": "#/$defs/library"}},
        "layout_grammar": {
          "type": "object", "required": ["max_width"],
          "properties": {"max_width": {"$ref": "#/$defs/text"}}
        },
        "interaction_signature": {
          "type": "object", "required": ["scroll_smoothing", "page_transitions"],
          "properties": {
            "scroll_smoothing": {"type": "boolean"}, "page_transitions": {"$ref": "#/$defs/text"}
          }
        },
        "palette": {
          "type": "object", "required": ["tokens"],
          "properties": {
            "tokens": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"}}
          }
        },
        "style": {"type": "object"}, "design_dna": {"type": "object"},
        "visual_thesis": {"$ref": "#/$defs/text"}, "voice_tier": {"$ref": "#/$defs/text"}
      }
    },
    "profileAsset": {
      "type": "object", "additionalProperties": false, "required": ["name", "origin", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "origin": {"enum": ["pack", "source"]},
        "sha256": {"$ref": "https://lintel.dev/schemas/review-v2.json#/$defs/digest"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "name", "version", "source", "license", "rationale", "evidence"],
      "properties": {
        "kind": {"enum": ["font", "library"]}, "name": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"},
        "license": {"$ref": "#/$defs/text"}, "rationale": {"$ref": "#/$defs/text"},
        "stacks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stack"}},
        "evidence": {"$ref": "#/$defs/files"}
      }
    },
    "override": {
      "type": "object", "additionalProperties": false, "required": ["field", "reason", "evidence"],
      "properties": {
        "field": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"},
        "evidence": {"$ref": "#/$defs/file"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_ref", "profile_asset", "brief", "project", "customer_share", "provenance", "overrides", "retrieval"],
      "properties": {
        "profile_ref": {"$ref": "https://lintel.dev/schemas/review-v2.json#/$defs/profile"},
        "profile_asset": {"$ref": "#/$defs/profileAsset"}, "brief": {"$ref": "#/$defs/file"},
        "project": {
          "type": "object", "additionalProperties": false, "required": ["existing", "stack", "manifests"],
          "properties": {
            "existing": {"type": "boolean"}, "stack": {"$ref": "#/$defs/stack"},
            "manifests": {"$ref": "#/$defs/files"}
          }
        },
        "customer_share": {"type": "boolean"},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
        "overrides": {"type": "array", "items": {"$ref": "#/$defs/override"}},
        "retrieval": {"$ref": "#/$defs/files"}
      }
    },
    "dimension": {
      "type": "object", "required": ["score", "findings"],
      "properties": {
        "score": {"anyOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]},
        "findings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}

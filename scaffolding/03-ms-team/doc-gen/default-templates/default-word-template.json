{
  "name": "default-word-template",
  "brand_version": "default-fallback",
  "description": "Generic neutral Word template used when ~/.lintel/brand/word-templates/ is empty. No MS brand identity carried.",
  "page_margin": { "top": 1, "bottom": 1, "left": 1.25, "right": 1.25, "unit": "inches" },
  "fonts": {
    "heading": "system-ui, -apple-system, Segoe UI, sans-serif",
    "body": "Cambria, Georgia, serif",
    "code": "Consolas, Monaco, monospace"
  },
  "styles": {
    "h1": { "size": 18, "weight": "bold", "color": "#1a1a1a", "space_before": 16, "space_after": 8 },
    "h2": { "size": 14, "weight": "bold", "space_before": 12, "space_after": 6 },
    "h3": { "size": 12, "weight": "bold", "space_before": 8, "space_after": 4 },
    "body": { "size": 11, "line_height": 1.5, "space_after": 4 },
    "code": { "size": 10, "background": "#f6f6f6", "font": "code" },
    "blockquote": { "size": 11, "italic": true, "indent": 0.5, "color": "#666666" }
  },
  "target_variants": ["technical", "customer-summary", "transparency-note"],
  "branding_marker": "DEFAULT (NO MS BRAND)",
  "voice_tier_default": "internal",
  "metadata_emitted_in_docx": {
    "Company": "Lintel default",
    "Subject": "Generated by /generate-word with default fallback template"
  }
}

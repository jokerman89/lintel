{
  "name": "default-ppt-template",
  "brand_version": "default-fallback",
  "description": "Generic neutral PPT template used when ~/.lintel/brand/ppt-templates/ is empty. No MS brand identity carried. Used by /generate-ppt as fallback.",
  "page_size": {
    "width": 13.333,
    "height": 7.5,
    "unit": "inches",
    "aspect": "16:9"
  },
  "fonts": {
    "title": "system-ui, -apple-system, Segoe UI, sans-serif",
    "body": "system-ui, -apple-system, Segoe UI, sans-serif",
    "code": "Consolas, Monaco, Courier New, monospace",
    "size_title": 36,
    "size_subtitle": 24,
    "size_body": 18,
    "size_caption": 12
  },
  "colors": {
    "primary": "#0078d4",
    "secondary": "#666666",
    "accent": "#005a9e",
    "background": "#ffffff",
    "ink": "#1a1a1a",
    "muted": "#999999"
  },
  "layouts": [
    {
      "name": "title",
      "elements": ["title", "subtitle", "presenter"],
      "notes": "Opening slide; title + presenter + date"
    },
    {
      "name": "title-and-content",
      "elements": ["title", "body", "footer"],
      "notes": "Standard content slide"
    },
    {
      "name": "two-column",
      "elements": ["title", "left", "right"],
      "notes": "Comparison or before/after"
    },
    {
      "name": "section-divider",
      "elements": ["section_title"],
      "notes": "Major section break"
    },
    {
      "name": "blank",
      "elements": [],
      "notes": "Free composition"
    },
    {
      "name": "closing",
      "elements": ["thanks", "contact"],
      "notes": "Final slide"
    }
  ],
  "branding_marker": "DEFAULT (NO MS BRAND)",
  "voice_tier_default": "trailblazer-draft",
  "metadata_emitted_in_pptx": {
    "Company": "Lintel default",
    "Subject": "Generated by /generate-ppt with default fallback template"
  }
}

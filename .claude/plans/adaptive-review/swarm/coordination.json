      "review": ".claude/plans/adaptive-review/swarm/reviews/P1.md"
    },
    {
      "task_id": "P2",
      "wave": 1,
      "role": "lintel-builder",
      "isolation": "git-worktree",
      "write_scope": ["lib/review_evaluation.py", "bin/li-review-eval.py", "tests/unit/review_evaluation.py", "tests/unit/review-evaluation.sh", "tests/fixtures/review-evaluation"],
      "brief": ".claude/plans/adaptive-review/swarm/briefs/P2.md",
      "report": ".claude/plans/adaptive-review/swarm/reports/P2.md",
      "review": ".claude/plans/adaptive-review/swarm/reviews/P2.md"
    }
  ]
}

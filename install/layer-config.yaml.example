# JStack layer config — example
#
# Copy to ~/.jstack/config.yaml and edit to override defaults.
# install.sh reads this file with strict YAML parse — typos in keys (e.g. layer3
# vs layer_3) produce a clear error, not a silent skip.

version: 1

# Per-layer install controls.
# The foundation layer is always enabled (required for any repo). Domain-specific
# behavior comes from the active pack, not from extra scaffolding layers.
layers:
  layer_1:
    enabled: true                   # required — install.sh refuses to disable
    install_path: ~/.jstack/scaffolding/01-foundation

# Compliance tier override.
# The active pack defines its own compliance gates (resolve_pack_field
# compliance.hooks; none by default). The neutral defaults below are
# pack-agnostic safety rules. Operator can ELEVATE any reference rule to
# on-demand or always-on per project.
# Operator CANNOT DISABLE the always-on rules — install.sh refuses.
compliance:
  always_on_rules:                  # non-negotiable
    - no_customer_data
    - no_secrets_in_prompts
    - no_production_mutation_without_auth
  on_demand_rules:                  # surfaced via the active pack's compliance gates
    - threat_model
    - sast_in_pipeline
  # elevations: list reference rule names here to promote them to always-on for this repo
  elevate_to_always_on: []

# Self-maintenance watchers (per Eng review session 2 A5).
# Soft warnings only — the harness CANNOT compact your conversation.
# These watchers surface /context-save when sessions get heavy.
watchers:
  token_watcher:
    enabled: true
    warn_threshold: 50000           # tokens; warn appears in statusline
    escalate_threshold: 80000       # tokens; stronger warning
  toolcall_watcher:
    enabled: true
    warn_threshold: 80              # tool calls per session
    escalate_threshold: 130

# Voice tier defaults.
# The active pack supplies its own voice tier (resolve_pack_field
# voice.default_tier; neutral default: internal). Operator can override the
# default per-skill via the skill's own frontmatter.
voice:
  default_tier: internal            # safe default — direct, builder-talking-to-builder

# Upstream sources (clone-time pins).
# upstream-sources.yaml carries the actual pin SHAs.
# This block lets operator opt-out of specific upstreams (e.g. team doesn't want ToB skills).
upstreams:
  gstack:               { enabled: true }
  gsd-redux:            { enabled: true }
  agentshield:          { enabled: true }
  ecc:                  { enabled: true }
  trailofbits-skills:   { enabled: true }    # CC-BY-SA-4.0 — restricted tier
  anthropic-skills:     { enabled: true }    # mixed Apache + source-available — restricted tier
  trailofbits-claude-code-config: { enabled: false }  # reference-only by default
  anthropic-plugins-official:     { enabled: false }  # reference-only by default

# CLI shim deployment.
# scaffold-repo.sh drops the appropriate shim into each target repo.
# Set to false to skip a CLI you don't use.
cli_shims:
  claude_code: true                 # drops CLAUDE.md
  copilot_enterprise: true          # drops .github/copilot-instructions.md
  codex: true                       # drops AGENTS.md
